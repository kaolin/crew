def cmd_setup(a):
    self_path = os.path.realpath(__file__)
    link = os.path.expanduser("~/.local/bin/crew")
    plist_path = os.path.expanduser(f"~/Library/LaunchAgents/{PLIST_LABEL}.plist")
    if a.dry_run:
        print(f"would symlink {link} -> {self_path}")
        print(f"would write   {plist_path}  (from this exact path — portable)")
        print(f"would load    {PLIST_LABEL} (snapshot every 300s)")
        print(f"would load    {PRUNE_LABEL} (tg-prune --days 30 --go, Sundays 04:10)")
        return
    os.makedirs(os.path.dirname(link), exist_ok=True)
    if os.path.lexists(link):
        os.remove(link)
    os.symlink(self_path, link)
    print(f"linked  {link} -> {self_path}")
    os.makedirs(os.path.dirname(plist_path), exist_ok=True)
    os.makedirs(SNAP_DIR, exist_ok=True)
    with open(plist_path, "w") as f:
        f.write(_plist_xml(self_path))
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{PLIST_LABEL}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", plist_path], capture_output=True)
    # Weekly inbox prune. Attachments older than 30 days have long been relayed; the
    # durable record is inbound.jsonl. Its own agent, not a side effect of snapshot.
    prune_path = os.path.expanduser(f"~/Library/LaunchAgents/{PRUNE_LABEL}.plist")
    with open(prune_path, "w") as f:
        f.write(_prune_plist_xml(self_path))
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{PRUNE_LABEL}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", prune_path], capture_output=True)
    print(f"loaded        {PRUNE_LABEL} (tg-prune --days 30 --go, Sundays 04:10)")
    print(f"loaded  {PLIST_LABEL} (snapshot every 300s)\n")
    cmd_doctor(a)


# ---- window labels: colour the tab so 15 near-identical windows tell apart ----
#
# Two halves, because they persist differently:
#   colour — an iTerm2 escape written to the session's tty. Display-layer, so it does
#            NOT reach the running claude's stdin, and it survives redraws. Live-settable.
#   name   — claude rewrites its own terminal title continuously ("◐ hub (node)"), so an
#            AppleScript `set name` is clobbered within a second. The only label that
#            sticks is the one claude prints itself, via `--name`, so restore bakes it in
#            and a live session keeps whatever name it launched with.

_TAB_COLORS = {          # muted, one per project, stable across restores
    "thereby":        (0, 122, 122),
    "izzit":          (208, 88, 64),
    "orrery":         (78, 86, 168),
    "spinnit":        (198, 148, 32),
    "fenriswatch":    (86, 110, 160),
    "beatboxing":     (168, 72, 136),
    "Sandpainting":   (150, 132, 72),
    "autostereogram": (64, 140, 92),
    "NamingRattle":   (128, 84, 160),
    "spacetag":       (48, 132, 156),
    "timeful":        (176, 96, 48),
    "fusiontrainer":  (60, 120, 72),
    "izzit_html":     (192, 112, 88),
    "erif_html":      (140, 110, 90),
    "dev":            (110, 110, 110),
    "kaolin":         (90, 90, 90),
}
_TAB_FALLBACK = [(120, 96, 150), (72, 128, 140), (160, 112, 64), (100, 132, 96), (150, 88, 104)]
_BADGE_CLEAR = "\033]1337;SetBadgeFormat=\a"
_BADGE_CLEAR_LITERAL = "\\033]1337;SetBadgeFormat=\\a"
_TAB_RESET = "\033]6;1;bg;*;default\a"


def _tab_color_for(p):
    if p in _TAB_COLORS:
        return _TAB_COLORS[p]
    return _TAB_FALLBACK[sum(ord(ch) for ch in (p or "?")) % len(_TAB_FALLBACK)]


def _title_escape(text, literal=False):
    """OSC 2 — WINDOW title only.

    The three levels are separate and claude only drives two of them: it writes the
    window title (a live summary of what it is doing, '✳ Moon's orbit in Cosmic Specks')
    and the session name (its --name, 'orrery-04'). OSC 2 sets the window title alone,
    so a static '[claude] <project>' can be pinned there. Note the cost: it replaces
    claude's running summary for that window until the next time claude rewrites it."""
    esc, bel = ("\\033", "\\a") if literal else ("\033", "\a")
    return f"{esc}]2;{text}{bel}"


def _tab_escape(rgb, literal=False):
    """The escape run. literal=True emits backslash sequences for a shell `printf`
    format instead of raw control bytes, so the command can be typed into a window."""
    esc, bel = ("\\033", "\\a") if literal else ("\033", "\a")
    r, g, b = rgb
    return "".join(f"{esc}]6;1;bg;{chan};brightness;{v}{bel}"
                   for chan, v in (("red", r), ("green", g), ("blue", b)))


def _write_tty(tty, s):
    """Write to a session's terminal device. Goes to the display, not the app's stdin."""
    if not tty:
        return False
    dev = tty if tty.startswith("/dev/") else "/dev/" + tty   # _tty_of already absolutises
    try:
        with open(dev, "w") as f:
            f.write(s)
        return True
    except Exception:
        return False


def _launcher_for(name):
    """~/.crew/launchers/<session>.sh, if one exists.

    For a session whose launch is more than flags — the hub carries the Telegram
    channel, its own settings file and the whole hub protocol as an appended system
    prompt — replaying what `ps` reported is brittle. A launcher script owns the
    invocation instead, and crew just appends --resume."""
    base = (name or "").replace("[claude] ", "").strip()
    if not base:
        return None
    p = os.path.join(SNAP_DIR, "launchers", base + ".sh")
