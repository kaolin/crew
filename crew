                             "claude-plugins-official", "telegram")
# Resolved without __file__: the pinger tests exec() this file, where it is undefined.
TG_PATCH_DIR = os.path.join(
    os.path.dirname(os.path.abspath(globals().get("__file__") or sys.argv[0])), "tgpatch")
