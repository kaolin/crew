# to Telegram, where its own messages never come back as inbound. It now also
# appends here, giving the hub a durable queue to catch up from.
PINGER_QUEUE = os.path.join(HOME, ".claude", "status", "_pinger.jsonl")
BRIEF_CURSOR = os.path.join(HOME, ".claude", "status", "_brief.cursor")

TG_PATCH_MARKERS = [
    ("durable inbound log", "INBOUND_LOG"),
    ("actioned-cursor replay", "ACTIONED_FILE"),
    ("quote-reply passthrough", "reply_to_message_id"),
    ("edit handler", "edited_message:text"),
    ("reaction handler", "message_reaction"),
    ("allowed_updates", "allowed_updates"),
]

# lower rank = more urgent / sorts first
STATUS_RANK = {"waiting": 0, "busy": 1, "idle": 2, "completed": 3, "stopped": 4, "failed": 5}
STATUS_STYLE = {
    "waiting":   ("33;1", "●"),  # yellow  — needs you
    "busy":      ("36;1", "▶"),  # cyan    — working
    "idle":      ("32",   "○"),  # green   — idle at prompt
    "completed": ("2",    "✓"),
    "stopped":   ("2",    "■"),
    "failed":    ("31;1", "✗"),
}


def c(code, s):
    if not sys.stdout.isatty():
        return s
    return f"\033[{code}m{s}\033[0m"


def _claude_bin():
    """Resolve the claude CLI even under a bare launchd PATH (bash login PATH != zsh)."""
    return (os.environ.get("CREW_CLAUDE")
            or shutil.which("claude")
            or os.path.expanduser("~/.local/bin/claude"))


def load(source=None, include_all=False):
    if source == "-":
        raw = sys.stdin.read()
    elif source:
        with open(source) as f:
            raw = f.read()
    else:
        cmd = [_claude_bin(), "agents", "--json"]
        if include_all:
            cmd.append("--all")
        raw = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    return json.loads(raw)


def age(ms):
    if not ms:
        return "?"
    s = max(0, int(time.time() * 1000 - ms) // 1000)
    if s < 60:
        return f"{s}s"
    m, s = divmod(s, 60)
    if m < 60:
        return f"{m}m"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h}h{m:02d}m"
    d, h = divmod(h, 24)
    return f"{d}d{h}h"


def proj(cwd):
    return os.path.basename((cwd or "").rstrip("/")) or (cwd or "?")


def shq(p):
    return "'" + p.replace("'", "'\\''") + "'"


def _as_str(s):
    """Escape for an AppleScript double-quoted literal. AppleScript eats backslashes,
    so a command carrying `\\033` escape sequences arrives mangled without this."""
    return (s or "").replace("\\", "\\\\").replace('"', '\\"')


def cmd_status(a):
    sessions = load(a.source, a.all)
    if not sessions:
        print("no running Claude sessions.")
        return
    groups = {}
    for s in sessions:
        groups.setdefault(s.get("cwd", "?"), []).append(s)
    # order groups by their most-urgent session, then by project name
    order = sorted(
        groups.items(),
        key=lambda kv: (min(STATUS_RANK.get(x.get("status"), 9) for x in kv[1]), proj(kv[0])),
    )
    tally = {}
    for s in sessions:
        tally[s.get("status", "?")] = tally.get(s.get("status", "?"), 0) + 1
    parts = [f"{n} {k}" for k, n in sorted(tally.items(), key=lambda kv: STATUS_RANK.get(kv[0], 9))]
    print(c("1", f"\n  {len(sessions)} sessions") + c("2", "   ·   " + "   ·   ".join(parts)) + "\n")
    for cwd, items in order:
        items.sort(key=lambda x: STATUS_RANK.get(x.get("status"), 9))
        print("  " + c("1", proj(cwd)) + c("2", f"   {cwd}"))
        for s in items:
            st = s.get("status", "?")
            code, glyph = STATUS_STYLE.get(st, ("0", "?"))
            line = (f"    {c(code, glyph)} {c(code, st.ljust(9))} "
                    f"{(s.get('name') or '').ljust(20)} {c('2', age(s.get('startedAt')).rjust(6))}")
            if s.get("waitingFor"):
                # The CLI always says "permission prompt"; a question meant for
                # kaolin looks identical until you read the transcript.
                p = _pending(s) if st == "waiting" else None
                if p and p["kind"] == "question":
                    line += c("33;1", "   ⟵ QUESTION FOR YOU")
                else:
                    line += c("33", f"   ⟵ {s['waitingFor']}")
            elif st == "busy" and at_prompt(s):
                # Busy only because a background shell/monitor is alive; the
                # model is done and the prompt will take input right now.
                line += c("2", "   ⟵ at prompt (bg task)")
            print(line)
        print()
    if not a.source:
        _report_unregistered(sessions)
        if _screen_locked() and not _probes_ok():
            print(c("2", "  (screen locked and Apple Events are crawling — no screen probes; 'at prompt' and 'pending'"
                         " read from transcripts only. Fix: defaults write com.googlecode.iterm2 NSAppSleepDisabled -bool YES)\n"))


def _unregistered(sessions):
    """claude processes running on this machine that `claude agents --json` does not list.

    A session that fails to finish starting — the machine was locked when its window
    opened, say — keeps its process and its iTerm window but never registers, so every
    crew command is blind to it. Four sat unnoticed for a day that way (2026-09-02)."""
    known = {str(s.get("pid")) for s in sessions}
    out = []
    try:
        ps = subprocess.run(["ps", "-eo", "pid=,tty=,command="], capture_output=True, text=True).stdout
    except Exception:
        return out
    for ln in ps.splitlines():
        parts = ln.split(None, 2)
        if len(parts) < 3:
            continue
        pid, tty, cmd = parts
        if not cmd.startswith("claude ") or pid in known:
            continue
        sid = cmd.split("--resume", 1)[1].split()[0] if "--resume" in cmd else "?"
        out.append((pid, tty, sid))
    return out


def _report_unregistered(sessions):
    rows = _unregistered(sessions)
    if not rows:
        return
    print(c("33", f"  ⚠ {len(rows)} claude process(es) running but NOT registered — crew cannot see or drive these:"))
    for pid, tty, sid in rows:
        home = _cwd_of_session(sid)
        print(f"      pid {pid:<7} {tty:<10} {proj(home) if home else '?':<16} {sid[:8]}")
    print(c("2", "      they never finished startup, so crew is blind to them. Two known causes: the"))
    print(c("2", "      trust-folder prompt (its default is 'No, exit'), and a window opened while the"))
    print(c("2", "      screen was locked. Look at the window — answering the prompt registers it.\n"))


def _cwd_of_session(sid):
    """Recover a session's project from its transcript path under ~/.claude/projects."""
    if not sid or sid == "?":
        return None
    root = os.path.join(HOME, ".claude", "projects")
    try:
        for d in os.listdir(root):
            if not os.path.exists(os.path.join(root, d, sid + ".jsonl")):
                continue
            # The dir name encodes the cwd with every "/" AND "_" flattened to "-",
            # so the decode is ambiguous (erif_html → .../erif/html). Prefer a path
            # that actually exists; otherwise hand back the encoded name unchanged.
            guess = "/" + d.strip("-").replace("-", "/")
            if os.path.isdir(guess):
                return guess
            for i in range(len(guess) - 1, 0, -1):   # try "_" for each "/", right to left
                alt = guess[:i] + "_" + guess[i + 1:] if guess[i] == "/" else None
                if alt and os.path.isdir(alt):
                    return alt
            return d.strip("-")
    except Exception:
        pass
    return None


def cmd_snapshot(a):
    sessions = load(a.source, include_all=False)
    os.makedirs(SNAP_DIR, exist_ok=True)
    path = a.out or os.path.join(SNAP_DIR, "latest.json")
    spaces = _spaces(a.spaces_source)
    # Record where each window ACTUALLY is (winspace) so restore rebuilds the real
    # layout, incl. untagged sessions; fall back to the tagged home. `spacetag windows`
    # is fetched once and shared. Skip live probes (winspace, launch-flag capture) in
    # test mode (--source given → fixture sessions with non-live pids).
    testmode = bool(a.source)
    # Window geometry is an Apple Event that takes 40–60 s while the screen is
    # locked (measured 2026-09-03); the agent would spend minutes per tick.
    # Locked → record the tagged home only; the next unlocked tick refreshes.
    wins = _windows() if (spaces and not testmode and not _screen_locked()) else None
    manifest = []
    for s in sessions:
        tty = _tty_of(s.get("pid")) if wins else None
        actual = _window_space_for_session(s, tty, spaces, wins) if wins else None
        # The session's INTENDED home (alias file, then tag-label match), recorded
        # alongside where the window actually sits. Without this the snapshot
        # faithfully preserves a scattered layout and restore rebuilds it forever.
        home = _space_for_session(s, spaces) if spaces else None
        sp = actual or home
        manifest.append({
            "cwd": s.get("cwd"), "sessionId": s.get("sessionId"),
            "name": s.get("name"), "status": s.get("status"),
            "launchArgs": [] if testmode else _launch_flags(s.get("pid")),
            "space": sp.get("uuid") if sp else None,
            "spaceIndex": sp.get("index") if sp else None,
            "spaceTag": sp.get("tag") if sp else None,
            "homeSpace": home.get("uuid") if home else None,
            "homeSpaceIndex": home.get("index") if home else None,
            "homeSpaceTag": home.get("tag") if home else None,
        })
    try:
        prev = json.load(open(path)) if os.path.exists(path) else []
    except Exception:
        prev = []
    # Safety: never let an empty/shrunk read (e.g. the launchd tick firing during
    # shutdown, when sessions are already dying) clobber a good reboot map.
    if not manifest and prev and not a.force:
        print(f"skip: 0 live sessions — keeping last good map ({len(prev)}) at {path}")
        return
    with open(path, "w") as f:
        json.dump(manifest, f, indent=2)
    if manifest and not a.out:  # keep a timestamped history of good maps
        hist = os.path.join(SNAP_DIR, "history")
        os.makedirs(hist, exist_ok=True)
        with open(os.path.join(hist, f"{int(time.time())}.json"), "w") as f:
            json.dump(manifest, f, indent=2)
    print(f"snapshotted {len(manifest)} sessions → {path}")
    # Interactive runs always get the drift report. The launchd agent fires every
    # five minutes and is not a tty, so it only speaks when the picture CHANGES —
    # otherwise the same 15-line warning lands in snapshot.log 288 times a day.
    if sys.stdout.isatty() or a.verbose or _drift_sets(manifest) != _drift_sets(prev):
        _report_space_drift(manifest)
    # The agent also keeps a finger on Tahoe's AppleScript regression: one timed
    # Apple Event, at most every 15 minutes, so `crew regression` can show whether
    # a macOS update fixed it. Interactive runs skip it (it can take 45 s locked).
    if not sys.stdout.isatty() and not a.source:
        try:
            fresh = os.path.exists(AE_LATENCY_LOG) and time.time() - os.path.getmtime(AE_LATENCY_LOG) < 900
        except OSError:
            fresh = False
        if not fresh:
            _sample_ae_latency()


def _drift_sets(manifest):
    """(drifted names, homeless names) — what the drift report is about, as sets
    so two snapshots compare cheaply."""
    drift = frozenset(m.get("name") for m in (manifest or [])
                      if m.get("homeSpace") and m.get("space") and m["space"] != m["homeSpace"])
    homeless = frozenset(m.get("name") for m in (manifest or []) if not m.get("homeSpace"))
    return drift, homeless


def _wherestr(index, tag):
    """'Space 7 · thereby', or 'Space 14 (untagged)' — never '· None'."""
    return f"Space {index} · {tag}" if tag else f"Space {index} (untagged)"


def _report_space_drift(manifest):
    """Say so when the layout being recorded is not the layout he meant.

    Two separate faults, and silence on either one is how a scattered layout
    becomes permanent: a window sitting somewhere other than its tagged home,
    and a project with no home at all (nothing to restore it to)."""
    drift = [m for m in manifest
             if m.get("homeSpace") and m.get("space") and m["space"] != m["homeSpace"]]
    homeless = [m for m in manifest if not m.get("homeSpace")]
    if not drift and not homeless:
        return
    if drift:
        print(c("33", f"\n  ⚠ {len(drift)} window(s) not on their tagged Space:"))
        for m in drift:
            print("      {:<20} on {}   → home is {}".format(
                m.get("name") or "?",
                _wherestr(m.get("spaceIndex"), m.get("spaceTag")),
                _wherestr(m.get("homeSpaceIndex"), m.get("homeSpaceTag"))))
        print(c("2", "      restore sends these home; `crew restore --as-found` keeps them where they are."))
    if homeless:
        print(c("33", f"\n  ⚠ {len(homeless)} session(s) with no Space tag — restore can only drop them wherever it is:"))
        for m in homeless:
            print("      {:<20} {}".format(m.get("name") or "?", proj(m.get("cwd"))))
        print(c("2", f"      fix: tag a Space for it, or map it in {os.path.join(SNAP_DIR, 'space_aliases.json')}"))
        print(c("2", '      e.g. {"fusiontrainer": "hidden game"}  (tag, index, or uuid)'))
    print()


def cmd_restore(a):
    path = a.source or os.path.join(SNAP_DIR, "latest.json")
    with open(path) as f:
        manifest = json.load(f)
    print(f"# restore {len(manifest)} sessions from {path}\n")
    # Re-resolve each session's home against the LIVE Spaces rather than trusting the
    # recorded position — a manifest taken while windows were scattered would otherwise
    # rebuild the scatter every reboot. Live lookup also repairs old manifests, which
    # have no homeSpace field, and picks up alias-file edits made since the snapshot.
    spaces = [] if getattr(a, "as_found", False) else _spaces(getattr(a, "spaces_source", None))
    homeless = []
    # A window opened by AppleScript while the login screen is up never starts its
    # shell (2026-09-03 12:05: "✓ orrery → Space 12", no login process, no claude,
    # an empty pane until unlock). Refuse rather than leave a trail of dead windows;
    # the operator can type the launch into an existing idle shell by tty instead.
    if a.go and _screen_locked() and not getattr(a, "even_locked", False):
        print(c("31", "  screen is locked — windows opened now never start their shell. "
                      "Unlock first, or type the launch into an existing idle shell by tty. "
                      "(--even-locked to try anyway)"))
        return
    # Folders that will stop at the trust dialog. Say so up front; after --go, answer it.
    untrusted = [(s.get("sessionId"), s.get("cwd")) for s in manifest
                 if s.get("cwd") and s.get("sessionId") and _trusted(s["cwd"]) is False]
    if untrusted:
        print(c("33", f"  ⚠ {len(untrusted)} folder(s) have not cleared the trust dialog — "
                      f"{'restore will answer it' if a.go else 'they would stop at it'}:"))
        for _, cwd in untrusted:
            print(f"      {cwd}")
        print()
    launched = 0
    for s in manifest:
        cwd, sid, name = s.get("cwd"), s.get("sessionId"), s.get("name") or ""
        if not cwd or not sid:
            continue
        space, moved = s.get("space"), None
        home = _space_for_session(s, spaces) if spaces else None
        if home and home.get("uuid") != space:
            if space:
                moved = "was on " + _wherestr(s.get("spaceIndex"), s.get("spaceTag"))
            space, s = home["uuid"], {**s, "spaceIndex": home.get("index"), "spaceTag": home.get("tag")}
        if spaces and not home:
            homeless.append((name, proj(cwd)))
        where = _wherestr(s.get("spaceIndex"), s.get("spaceTag")) if space else "current Space"
        if moved:
            where += c("2", f"   ({moved})")
        # claude renders its own name into the window title, so `--name` is the only
        # label it will never overwrite. Rewrite an existing one rather than skipping:
        # the hub already launches with `--name hub` and would otherwise stay unlabelled.
        args = list(s.get("launchArgs") or [])
        label = label_name(cwd, name, manifest)
        for i, x in enumerate(args):
            if x in ("--name", "-n") and i + 1 < len(args):
                args[i + 1] = label
                break
        else:
            args += ["--name", label]
        launcher = _launcher_for(name)
        flagstr = "" if launcher else "".join(" " + shq(f) for f in args)
        cmd = shq(launcher) if launcher else "claude" + flagstr
        tint = (_tab_escape(_tab_color_for(proj(cwd)), literal=True) + _BADGE_CLEAR_LITERAL
                + _title_escape(label, literal=True))
        resume = f"printf {shq(tint)} && cd {shq(cwd)} && {cmd} --resume {sid}"
        if a.go:
            if space:
                subprocess.run([_spacetag_bin(), "goto", str(space)])  # land the new window on its Space
            script = ('tell application "iTerm2"\n'
                      '  create window with default profile\n'
                      '  tell current session of current window\n'
                      f'    set name to "{_as_str(name)}"\n'
                      f'    write text "{_as_str(resume)}"\n'
                      '  end tell\n'
                      'end tell')
            subprocess.run(["osascript", "-e", script], check=False)
            print(f"  ✓ {name.ljust(20)} → {where}")
        else:
            print(f"  would put {name.ljust(20)} → {where}   ({resume})")
        launched += 1
    if homeless:
        print(c("33", f"\n  ⚠ {len(homeless)} session(s) with no Space tag — left on whatever Space was current:"))
        for name, p in homeless:
            print("      {:<20} {}".format(name or "?", p))
        print(c("2", f"      fix: tag a Space for it, or map it in {os.path.join(SNAP_DIR, 'space_aliases.json')}"))
    if a.go and untrusted:
        print(c("2", f"\n  waiting for {len(untrusted)} trust prompt(s)…"))
        done, left = _answer_trust_prompts(untrusted)
        for _, cwd in done:
            print(f"  ✓ trusted {cwd}")
        for _, cwd in left:
            print(c("33", f"  ⚠ {cwd}: no trust prompt seen — look at the window"))
    if not a.go:
        print(f"\n# dry-run: {launched} sessions. re-run with --go to open + place + resume.")


# ---- dispatch: attach to the live iTerm2 session behind a Claude pid ----

def _resolve(sessions, key):
    """Find sessions by exact name, name-prefix, project, then substring."""
    for pred in (
        lambda s: (s.get("name") or "") == key,
        lambda s: (s.get("name") or "").startswith(key),
        lambda s: proj(s.get("cwd")) == key,
        lambda s: key.lower() in ((s.get("name") or "") + " " + (s.get("cwd") or "")).lower(),
    ):
        hit = [s for s in sessions if pred(s)]
        if hit:
            return hit
    return []


def _tty_of(pid):
    if not pid:
        return None
    out = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return None if not out or out == "??" else "/dev/" + out


def _parse_flags(args):
    """From a `ps args` line ('claude --dangerously-skip-permissions --resume X'),
    return the launch flags worth replaying — minus resume/continue/print/bg, since
    restore re-adds its own --resume."""
    toks = args.split()
    if toks and not toks[0].startswith("-"):
        toks = toks[1:]  # drop the executable (claude / full path)
    drop = {"--resume", "-r", "--continue", "-c", "--fork-session", "--from-pr",
            "--print", "-p", "--bg", "--background"}
    takes_val = {"--resume", "-r", "--from-pr"}
    out, i = [], 0
    while i < len(toks):
        t = toks[i]
        if t in drop:
            i += 2 if (t in takes_val and i + 1 < len(toks) and not toks[i + 1].startswith("-")) else 1
            continue
        out.append(t)
        i += 1
    return out


def _launch_flags(pid):
    """Recover a running claude's launch flags so restore replays --dangerously-skip-permissions, --model, etc."""
    if not pid:
        return []
    args = subprocess.run(["ps", "-ww", "-o", "args=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    return _parse_flags(args) if args else []


# AppleScript takes (tty[, msg]) via `on run argv`, so we never string-escape into the script body.
_OSA_PEEK = """on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is target then return contents of s
        end repeat
      end repeat
    end repeat
  end tell
  return "__NOTFOUND__"
end run"""

# Typing and submitting are two separate scripts: a lone CR sent right after a
# multi-line `write text` gets swallowed by the terminal's bracketed-paste
# accumulation instead of submitting, so the adapter types, lets a multi-line
# paste settle, then sends the Enter as a distinct keystroke.
_OSA_TYPE = """on run argv
  set target to item 1 of argv
  set msg to item 2 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is target then
            tell s to write text msg newline no
            return "__OK__"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "__NOTFOUND__"
end run"""

_OSA_SUBMIT = """on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is target then
            tell s to write text (character id 13) newline no
            return "__OK__"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "__NOTFOUND__"
end run"""

_OSA_JUMP = """on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is target then
            select s
            tell t to select
            tell w to select
            activate
            return "__OK__"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "__NOTFOUND__"
end run"""


def _pick(name):
    sessions = load()
    matches = _resolve(sessions, name)
    if not matches:
        print(f"no running session matches '{name}'")
        return None, None
    if len(matches) > 1:
        print(f"'{name}' is ambiguous — matches:")
        for m in matches:
            print(f"    {m.get('name')}   {proj(m.get('cwd'))}   [{m.get('status')}]")
        return None, None
    s = matches[0]
    tty = _tty_of(s.get("pid"))
    if not tty:
        print(f"couldn't find the tty for {s.get('name')} (pid {s.get('pid')})")
        return None, None
    return s, tty


def _osa(script, *args):
    return subprocess.run(["osascript", "-", *args], input=script, capture_output=True, text=True).stdout


# ---- dispatch adapters: how to peek / tell / jump / read-bounds for a session ----
# Awareness (`claude agents --json`) is terminal-agnostic — it reports every session
# regardless of the terminal it runs in. Only these four verbs are terminal-specific.
# Each adapter maps a live tty to a terminal handle and acts in place. iTerm2 is the
# only backend today; a tmux (or remote-over-ssh) backend drops in by implementing the
# same four methods and teaching `adapter_for()` to route to it — nothing else changes.

def settle_for(msg):
    """How long to let a paste land before pressing Enter.

    Submitting early truncates it, and nothing surfaces the loss — the send
    reports success and the screen looks right; only the receiving session's
    transcript shows the message beginning mid-word."""
    return min(0.6 + len(msg) / 1200.0, 6.0)


CHUNK = 600


def chunks_of(msg, size=CHUNK):
    """Split msg for delivery, preferring line boundaries.

    One big write loses its FRONT — on 2026-08-06 a 1.15 KB relay arrived as
    1018 chars starting mid-path, and simply waiting longer before Enter didn't
    help, because the loss happens as the text goes in rather than at submit.
    Short writes land whole, so send several instead of one."""
    if len(msg) <= size:
        return [msg]
    out, buf = [], ""
    for line in msg.splitlines(keepends=True):
        while len(line) > size:                    # a single monster line
            if buf:
                out.append(buf); buf = ""
            out.append(line[:size]); line = line[size:]
        if len(buf) + len(line) > size:
            out.append(buf); buf = ""
        buf += line
    if buf:
        out.append(buf)
    return out


class ITerm2Adapter:
    """Drive the live iTerm2 session behind a tty via AppleScript."""
    name = "iTerm2"

    def peek(self, tty):
        """Return the session's on-screen contents, or None if not in this iTerm2."""
        out = _osa(_OSA_PEEK, tty)
        return None if "__NOTFOUND__" in out else out

    def tell(self, tty, msg):
        """Type + submit msg into the session, letting a long paste land first.

        A flat 0.6s was enough for a short multi-line note and silently WRONG for
        a long one: on 2026-08-06 two ~1.8 KB relays submitted mid-paste and
        arrived beheaded, each starting mid-word. Claude Code had accepted only
        what had streamed in by the time Enter fired, and neither the send nor
        the screen showed anything amiss — the loss was only visible in the
        receiving session's transcript.

        So scale the wait with size, and cap it so a huge paste can't hang."""
        parts = chunks_of(msg)
        for i, part in enumerate(parts):
            if "__OK__" not in _osa(_OSA_TYPE, tty, part):
                return False
            if i < len(parts) - 1:
                time.sleep(0.35)                  # let each chunk register
        if "\n" in msg or len(msg) > 400:
            time.sleep(settle_for(msg))
        return "__OK__" in _osa(_OSA_SUBMIT, tty)

    def keys(self, tty, chunk):
        """Send raw bytes with NO trailing Enter — the only way to drive a
        multi-select (Space toggles, arrows move). `tell` always submits, which
        silently does nothing to a checkbox list (2026-08-03, disasteroids)."""
        return "__OK__" in _osa(_OSA_TYPE, tty, chunk)

    def jump(self, tty):
        """Front the session's window/tab/pane. Returns True on success."""
        return "__OK__" in _osa(_OSA_JUMP, tty)

    def bounds(self, tty):
        """Return the window's (x, y, w, h) for Space matching, or None."""
        out = _osa(_OSA_BOUNDS, tty).strip()
        if "," not in out or "__NOTFOUND__" in out:
            return None
        try:
            l, t, r, b = [int(float(v)) for v in out.split(",")[:4]]
        except Exception:
            return None
        return (l, t, r - l, b - t)


_ITERM2 = ITerm2Adapter()


IT2_PY = os.path.join(os.path.dirname(os.path.abspath(globals().get("__file__") or sys.argv[0])), "it2.py")
IT2_PYTHON = os.environ.get("CREW_IT2_PYTHON") or os.path.expanduser("~/miniconda3/bin/python")
_IT2_OK = None   # per-process: did the API answer? None = not asked yet


class ITerm2ApiAdapter:
    """Drive iTerm2 through its Python API (a websocket over a Unix socket) via
    it2.py, instead of Apple Events.

    Why: on macOS 26 with the login screen up, EVERY Apple Event to iTerm2 takes
    4–60 s (measured 2026-09-03: 4.9, 4.1, 15.6, 34, >60 s), and the AppleScript
    adapter spends one event per session just to find a tty. The API reads a
    screen in ~1 s locked or not. Its only Apple-Event dependency is the login
    cookie; `it2.py mint` fetches one while unlocked and caches it in ~/.crew.

    Falls back to the AppleScript adapter for anything it cannot do."""
    name = "iTerm2-api"

    def _run(self, *args, timeout=20):
        try:
            return subprocess.run([IT2_PYTHON, IT2_PY, *args], capture_output=True, text=True, timeout=timeout)
        except Exception:
            return None

    # Any non-zero answer falls back to AppleScript, INCLUDING "no session on that
    # tty" (rc 2): the API's tty variable did not match /dev/ttys046 for a session
    # AppleScript found fine (thereby-8e, 2026-09-03 13:36, a relay bounced). The
    # API is an accelerator, never the arbiter of whether a session exists.

    def peek(self, tty):
        r = self._run("peek", tty)
        if r is None or r.returncode != 0:
            return _ITERM2.peek(tty)
        return r.stdout

    def tell(self, tty, msg):
        r = self._run("send", tty, msg, timeout=30)
        if r is None or r.returncode != 0:
            return _ITERM2.tell(tty, msg)
        if "\n" in msg or len(msg) > 400:
            time.sleep(settle_for(msg))
        r2 = self._run("send", tty, "\r")
        return bool(r2 and r2.returncode == 0) or _ITERM2.keys(tty, "\r")

    def keys(self, tty, chunk):
        r = self._run("send", tty, chunk)
        if r is None or r.returncode != 0:
            return _ITERM2.keys(tty, chunk)
        return True

    def jump(self, tty):
        return _ITERM2.jump(tty)               # window fronting stays on AppleScript

    def bounds(self, tty):
        return _ITERM2.bounds(tty)


_ITERM2_API = ITerm2ApiAdapter()


def _it2_available():
    """True when it2.py can reach iTerm2 within its budget. Asked once per
    process; a locked screen with no cached cookie answers 'no' in ~6 s and
    everything then goes the AppleScript way, as before."""
    global _IT2_OK
    if _IT2_OK is None:
        _IT2_OK = False
        if os.path.exists(IT2_PY) and os.path.exists(IT2_PYTHON):
            r = _ITERM2_API._run("ping", timeout=12)
            _IT2_OK = bool(r and r.returncode == 0)
    return _IT2_OK


class TmuxAdapter:
    """Drive a claude running inside a tmux pane (any socket) via tmux itself.
    Bound to a resolved (socket, target); `adapter_for` builds one per tmux tty."""
    name = "tmux"

    def __init__(self, socket, target):
        self.socket, self.target = socket, target

    def _tmux(self, *args):
        return subprocess.run(["tmux", "-L", self.socket, *args], capture_output=True, text=True)

    def peek(self, tty):
        r = self._tmux("capture-pane", "-t", self.target, "-p")
        return r.stdout if r.returncode == 0 else None

    def tell(self, tty, msg):
        if "\n" in msg:
            # bracketed paste so the TUI takes it as one paste, not line-by-line
            # (raw newlines via send-keys -l can submit early); settle, then Enter.
            self._tmux("set-buffer", "-b", "crew_tell", msg)
            self._tmux("paste-buffer", "-d", "-p", "-b", "crew_tell", "-t", self.target)
            time.sleep(settle_for(msg))   # see ITerm2Adapter.tell — flat 0.6s beheaded long relays
        else:
            self._tmux("send-keys", "-t", self.target, "-l", msg)   # literal text, then submit
        return self._tmux("send-keys", "-t", self.target, "Enter").returncode == 0

    def keys(self, tty, chunk):
        """Raw bytes, no Enter — see the iTerm2 adapter's keys() for why."""
        return self._tmux("send-keys", "-t", self.target, "-l", chunk).returncode == 0

    def jump(self, tty):
        # select the pane within tmux (can't front the attached GUI terminal window)
        self._tmux("select-window", "-t", self.target)
        return self._tmux("select-pane", "-t", self.target).returncode == 0

    def bounds(self, tty):
        return None  # a tmux pane has no window bounds — winspace falls back to tag-map


_TMUX_CACHE = None


def _parse_panes(sock, text):
    out = {}
    for line in text.splitlines():
        if "\t" in line:
            ptty, target = line.split("\t", 1)
            out[ptty] = (sock, target)
    return out


def _tmux_panes():
    """Map every tmux pane's tty -> (socket, target) across all live sockets (cached
    per run). Robust to no tmux, dead/stale sockets, and a bare launchd PATH."""
    global _TMUX_CACHE
    if _TMUX_CACHE is not None:
        return _TMUX_CACHE
    out, tmuxbin = {}, shutil.which("tmux")
    sockdir = os.environ.get("TMUX_TMPDIR") or f"/tmp/tmux-{os.getuid()}"
    if tmuxbin:
        try:
            socks = os.listdir(sockdir)
        except Exception:
            socks = []
        for sock in socks:
            try:
                r = subprocess.run(
                    [tmuxbin, "-L", sock, "list-panes", "-a", "-F",
                     "#{pane_tty}\t#{session_name}:#{window_index}.#{pane_index}"],
                    capture_output=True, text=True)
            except Exception:
                continue
            if r.returncode == 0:
                out.update(_parse_panes(sock, r.stdout))
    _TMUX_CACHE = out
    return out


def _tmux_pane_of(tty):
    return _tmux_panes().get(tty)


def adapter_for(tty):
    """Pick the dispatch backend for a session's tty: a TmuxAdapter when the tty
    belongs to a tmux pane (any socket), else iTerm2."""
    pane = _tmux_pane_of(tty)
    if pane:
        return TmuxAdapter(*pane)
    return _ITERM2_API if _it2_available() else _ITERM2


# ---- spaces: leverage spacetag's CLI to switch to a session's Space ----

def _spacetag_bin():
    env = os.environ.get("CREW_SPACETAG")
    if env:
        return env
    dev = os.path.expanduser(
        "~/dev/spacetag/build/dd/Build/Products/Debug/spacetags-pro.app/Contents/MacOS/spacetags-pro")
    return dev if os.path.exists(dev) else "/Applications/spacetags-pro.app/Contents/MacOS/spacetags-pro"


def _spaces(source=None):
    if source:
        with open(source) as f:
            return json.load(f)
    try:
        return json.loads(subprocess.run([_spacetag_bin(), "dump"], capture_output=True, text=True).stdout)
    except Exception:
        return []


def _norm(s):
    return "".join(ch for ch in (s or "").lower() if ch.isalnum())


def _aliases():
    try:
        return json.load(open(os.path.join(SNAP_DIR, "space_aliases.json")))
    except Exception:
        return {}


def _space_for_session(s, spaces):
    """Map a session to a tagged Space: alias file first, then tag-label match
    (kaolin labels his Spaces by project, so this is usually exact)."""
    cwd = s.get("cwd") or ""
    projn, namen, cwdn = _norm(proj(cwd)), _norm(s.get("name")), _norm(cwd)
    want = _aliases().get(proj(cwd)) or _aliases().get(s.get("name") or "")
    if want is not None:
        wantn = _norm(str(want))
        for sp in spaces:
            # Substring, not equality: a Space gets renamed ("hidden game" →
            # "magic messages / hidden game") and an exact-match alias silently
            # stops resolving, which looks like the session lost its home.
            if (str(sp.get("index")) == str(want) or sp.get("uuid") == want
                    or (wantn and wantn in _norm(sp.get("tag")))):
                return sp
    for sp in spaces:
        tagn = _norm(sp.get("tag"))
        if not tagn:
            continue
        if (projn and (projn in tagn or tagn in projn)) or (tagn in cwdn) or (namen and tagn in namen):
            return sp
    return None


# ---- winspace: where a session's window ACTUALLY is (bounds match) ----

_OSA_BOUNDS = """on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is target then
            set b to bounds of w
            return ((item 1 of b) as string) & "," & ((item 2 of b) as string) & "," & ((item 3 of b) as string) & "," & ((item 4 of b) as string)
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "__NOTFOUND__"
end run"""


def _windows():
    try:
        return json.loads(subprocess.run([_spacetag_bin(), "windows"], capture_output=True, text=True).stdout)
    except Exception:
        return []


def _tag_for(uuid, spaces):
    for sp in (spaces or []):
        if sp.get("uuid") == uuid:
            return sp.get("tag")
    return None


def _window_space_for_session(s, tty, spaces, wins=None):
    """Where the session's iTerm2 window ACTUALLY is: read its bounds (AppleScript)
    and match against `spacetag windows`. Handles untagged/home sessions, no config.
    Pass `wins` (a prefetched `spacetag windows` list) to avoid refetching per session."""
    if not tty:
        return None
    xywh = adapter_for(tty).bounds(tty)
    if not xywh:
        return None
    x, y, w, h = xywh
    for win in (wins if wins is not None else _windows()):
        if (win.get("owner") or "") != "iTerm" or not win.get("space"):
            continue
        if abs(win["x"] - x) <= 8 and abs(win["y"] - y) <= 8 and abs(win["w"] - w) <= 8 and abs(win["h"] - h) <= 8:
            return {"uuid": win["space"], "index": win.get("spaceIndex"), "tag": _tag_for(win["space"], spaces)}
    return None


# ---- transcript: read a session's conversation from its JSONL (terminal-agnostic) ----

def _jsonl_path(s):
    enc = (s.get("cwd") or "").replace("/", "-")
    return os.path.join(HOME, ".claude", "projects", enc, (s.get("sessionId") or "") + ".jsonl")


def _msg_text(r):
    c = r.get("message", {}).get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        parts = []
        for b in c:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text":
                parts.append(b.get("text", ""))
            elif b.get("type") == "tool_use":
                parts.append(f"[{b.get('name', 'tool')}]")
        return "\n".join(p for p in parts if p.strip())
    return ""


def _parse_turns(lines):
    turns = []
    for ln in lines:
        try:
            r = json.loads(ln)
        except Exception:
            continue
        if r.get("type") in ("user", "assistant"):
            t = _msg_text(r).strip()
            if t:
                turns.append((r["type"], t))
    return turns


def _read_turns(s):
    """All (role, text) turns from the session's JSONL, in order. [] if unreadable."""
    try:
        with open(_jsonl_path(s), errors="ignore") as f:
            return _parse_turns(f)
    except Exception:
        return []


def _jsonl_lines(s):
    try:
        with open(_jsonl_path(s), "rb") as f:
            return sum(1 for _ in f)
    except Exception:
        return 0


def _assistant_since(s, before_lines):
    """Assistant messages that appear after line `before_lines` — i.e. the reply to a
    just-sent prompt."""
    out = []
    try:
        with open(_jsonl_path(s), errors="ignore") as f:
            for i, ln in enumerate(f):
                if i < before_lines:
                    continue
                try:
                    r = json.loads(ln)
                except Exception:
                    continue
                if r.get("type") == "assistant":
                    t = _msg_text(r).strip()
                    if t:
                        out.append(t)
    except Exception:
        pass
    return out


def _pending(s, tail=400, screen=True):
    """What a `waiting` session is actually blocked on, from its transcript.

    `claude agents --json` only ever says waitingFor="permission prompt", but the
    two cases need OPPOSITE handling from the hub:

      question   — an AskUserQuestion meant for kaolin. Anything typed at it is
                   consumed as his answer. (2026-07-31: a stray hub probe got
                   submitted as the answer to orrery's IAP-name question.)
      permission — a tool-approval dialog. Typed text can select an option, so
                   sending is worse than useless.

    Returns {kind, tool, detail, options} or None if nothing is pending.
    A tool_use with no matching tool_result is the thing being waited on.
    """
    try:
        with open(_jsonl_path(s), errors="ignore") as f:
            lines = f.readlines()[-tail:]
    except Exception:
        return None

    answered, pend = set(), None
    for ln in lines:
        try:
            r = json.loads(ln)
        except Exception:
            continue
        body = (r.get("message") or {}).get("content")
        if not isinstance(body, list):
            continue
        for b in body:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_result" and b.get("tool_use_id"):
                answered.add(b["tool_use_id"])
            elif b.get("type") == "tool_use":
                pend = b
    if not pend or pend.get("id") in answered:
        # The tool_use isn't always logged before the prompt goes up; the screen
        # is authoritative for what's actually being asked.
        return _classify_screen(_screen_tail(s)) if screen else None

    name, inp = pend.get("name", "tool"), pend.get("input") or {}
    if name == "AskUserQuestion":
        qs = inp.get("questions") or []
        q = qs[0] if qs else {}
        return {"kind": "question", "tool": name,
                "detail": q.get("question", "(unspecified question)"),
                "options": [o.get("label", "") for o in (q.get("options") or [])]}
    detail = inp.get("command") or inp.get("file_path") or inp.get("url") or ""
    if not detail:
        detail = json.dumps(inp)[:200] if inp else ""
    return {"kind": "permission", "tool": name,
            "detail": " ".join(str(detail).split())[:300], "options": []}


# The option-picker chrome Claude Code draws for AskUserQuestion. Present on
# screen even when the tool_use hasn't been written to the transcript yet.
_ASK_CHROME = ("Enter to select", "↑/↓ to navigate")


def _classify_screen(rows):
    """Screen rows → a _pending-shaped dict, or None. Used when the transcript
    hasn't logged the pending tool_use (live case, 2026-08-01: sandpainting)."""
    if not rows:
        return None
    blob = "\n".join(rows)
    if not any(k in blob for k in _ASK_CHROME):
        return None
    opts, question = [], ""
    for ln in rows:
        t = ln.strip().lstrip("❯").strip()
        m = re.match(r"^(\d+)\.\s+(.*)$", t)
        if m:
            opts.append(m.group(2).strip())
        elif not opts and t and not t.startswith("─"):
            question = t                      # last prose line before the options
    if not opts:
        return None
    opts = [o for o in opts if o.lower() not in ("type something.", "chat about this")]
    return {"kind": "question", "tool": "AskUserQuestion",
            "detail": question or "(see the screen)", "options": opts}


_LOCKED = None


def _screen_locked():
    """Is the login screen up? Read from IOKit — 30 ms, no AppleScript.

    Matters because every screen probe goes through iTerm2 via osascript, and with
    the screen locked each of those takes 10–20 s instead of milliseconds. A
    `crew status` with three busy sessions blew through a two-minute budget on
    2026-09-03 03:13 that way. Memoised per process: one answer per run."""
    global _LOCKED
    if _LOCKED is None:
        try:
            out = subprocess.run(["ioreg", "-n", "Root", "-d1", "-a"],
                                 capture_output=True, text=True, timeout=5).stdout
            _LOCKED = "CGSSessionScreenIsLocked" in out
        except Exception:
            _LOCKED = False
    return _LOCKED


_PROBES_OK = None


def _probes_ok():
    """May we screen-scrape right now? Unlocked: always. Locked: only if one
    trial Apple Event comes back fast.

    The root cause of the locked-screen crawl (2026-09-03) was App Nap: with the
    login screen up iTerm2 is a background app, macOS naps it, and every Apple
    Event to it takes 4–60 s. `defaults write com.googlecode.iterm2
    NSAppSleepDisabled -bool YES` takes that to 0.05 s. This probe is the guard
    for the day that setting is missing or the OS changes again: a slow trial
    means skip the scrape (callers fall back to transcripts) rather than hang."""
    global _PROBES_OK
    if _PROBES_OK is None:
        # Measured 2026-09-03 09:25, screen locked, App Nap already off for
        # iTerm2: `get version` 0.05 s; `count of sessions` 0.8 s; `contents of
        # session` by tty 0.75 s once and 30+ s the next two times; `bounds of
        # window` and `name of current window` 40–60 s every time. A cheap trial
        # event therefore proves nothing about the next one. While locked, the
        # transcript is the only source that answers in bounded time — so no
        # scraping at all, and the snapshot agent must not ask for window bounds.
        _PROBES_OK = not _screen_locked()
    return _PROBES_OK


def _screen_tail(s, lines=18):
    """Last N lines of the session's live terminal, or [] if not scrapeable.
    The transcript is structured but lags; the screen is what's actually asking."""
    if not _probes_ok():
        return []   # Apple Events are crawling; the caller falls back to the transcript
    try:
        tty = _tty_of(s.get("pid"))
        if not tty:
            return []
        out = adapter_for(tty).peek(tty)
        if not out:
            return []
        rows = [x.rstrip() for x in out.replace("\r", "\n").split("\n")]
        return [x for x in rows if x.strip()][-lines:]
    except Exception:
        return []


def generating(rows):
    """True when the model is mid-turn on this screen.

    Two independent tells, either sufficient:
      * the footer offers "esc to interrupt" — only shown while a turn runs;
      * the spinner is live — "✻ Manifesting… (3m 2s · ↓ 8.2k tokens)". Note the
        ellipsis and parenthesised counter. A *finished* turn leaves the spinner
        line behind in past tense — "✻ Sautéed for 13m 14s · 1 shell still
        running" — so matching on "✻" alone would read done as running."""
    for r in rows or []:
        if "esc to interrupt" in r:
            return True
        if r.lstrip().startswith("✻") and re.search(r"…\s*\(", r):
            return True
    return False


def prompt_text(s, rows=None):
    """Whatever the input line shows, or "" if the box is bare.

    DO NOT read this as "text the user typed". Claude Code renders a suggested
    next message as ghost text in the same place, and a terminal scrape has no
    styling to tell them apart. On 2026-08-06 this fooled us both: five sessions
    were reported to kaolin as holding his unsent drafts, he said one "doesn't
    sound like me", and a probe settled it — typing a single character replaced
    the line entirely, so the box had been empty all along. Their transcripts
    confirmed it: "commit all this" and "go ahead on the textures" were never
    received by any session, and pressing Enter on them submitted nothing.

    Real typed text does exist too ("man I wish I hadn't looked at ipad LOL"
    was genuine and did submit). The only reliable discriminator found so far
    is intrusive — type a character and see whether it appends or replaces —
    so callers must not act on this value, only display it as unverified."""
    rows = _screen_tail(s, lines=12) if rows is None else rows
    for r in (rows or [])[-6:]:
        t = r.strip()
        if t.startswith("❯"):
            return t[1:].strip()
    return ""


def at_prompt(s, rows=None):
    """True when the session is typeable right now — model idle, input box up.

    `claude agents --json` reports **busy** while any background shell, monitor
    or task is alive, even after the model has finished. On 2026-08-05
    thereby-ed sat "busy" for three hours with a finished report on screen and a
    watcher waiting on an offline phone; the pinger called it "may be hung" and
    four queued relays never went in.

    The ❯ box alone does NOT mean idle — Claude Code keeps it up while
    generating so you can queue input (caught live against the hub itself,
    which reported "at prompt" mid-turn). So require the box *and* the absence
    of any generating tell.

    The box counts whether or not it has text on it. Requiring a *bare* ❯ was
    wrong: Claude Code puts a ghost suggestion there, which is not input and
    doesn't stop the session accepting a message. That mistake stalled several
    queued relays on 2026-08-06, each waiting for a box that would never look
    empty."""
    rows = _screen_tail(s, lines=12) if rows is None else rows
    rows = rows or []
    return any(r.strip().startswith("❯") for r in rows[-6:]) and not generating(rows)


def _pending_line(p):
    """One-line summary of a pending prompt, for status/refusal messages."""
    if not p:
        return "waiting (nothing pending in transcript — check the terminal)"
    if p["kind"] == "question":
        opts = f"  [{' / '.join(o for o in p['options'] if o)}]" if p["options"] else ""
        return f"QUESTION FOR YOU: {p['detail']}{opts}"
    return f"permission: {p['tool']} — {p['detail']}"


def _session_now(sid):
    """Refetch one session's live record from `claude agents --json` (for polling)."""
    try:
        for x in load(include_all=True):
            if x.get("sessionId") == sid:
                return x
    except Exception:
        pass
    return None


_ARTIFACT_RE = re.compile(
    r"https://claude\.ai/[a-z/]*artifacts?/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)


def _artifact_urls(text):
    return _ARTIFACT_RE.findall(text or "")


def cmd_artifacts(a):
    """A gallery of every live artifact URL your fleet has published (from transcripts)."""
    found = False
    for s in load(include_all=a.all):
        seen, urls = set(), []
        try:
            with open(_jsonl_path(s), errors="ignore") as f:
                for ln in f:
                    for u in _artifact_urls(ln):
                        if u not in seen:
                            seen.add(u)
                            urls.append(u)
        except Exception:
            continue
        if not urls:
            continue
        found = True
        print(c("1", f"\n  {s.get('name')}") + c("2", f"  ({proj(s.get('cwd'))})"))
        for u in urls[-a.limit:]:
            print("    " + u)
    print() if found else print("no artifacts found in any live session transcript.")


def cmd_peek(a):
    s, tty = _pick(a.name)
    if not s:
        return
    hdr = c("1", f"{s.get('name')}  [{s.get('status')}]  {proj(s.get('cwd'))}")
    if s.get("waitingFor"):
        hdr += c("33", f"   ⟵ {s['waitingFor']}")
        if s.get("status") == "waiting":
            hdr += "\n  " + c("33;1", _pending_line(_pending(s)))
    if a.screen:  # raw terminal scrape — the live TUI (needs a drivable adapter)
        ad = adapter_for(tty)
        out = ad.peek(tty)
        if out is None:
            print(f"{s.get('name')} isn't reachable via {ad.name} (tty {tty}) — different terminal?")
            return
        print(hdr + c("2", f"   {tty}"))
        for ln in out.replace("\r", "\n").rstrip("\n").split("\n")[-a.lines:]:
            print("  " + ln)
        return
    # default: the conversation, from the transcript (fast, works for ANY terminal)
    turns = _read_turns(s)[-a.turns:]
    print(hdr)
    for role, text in turns:
        who = c("36", "you ›") if role == "user" else c("32", "claude ›")
        body = text if len(text) <= 700 else text[:700] + c("2", " …")
        print(f"  {who} {body}\n")
    if not turns:
        print(c("2", "  (no transcript)"))


def _blocked_refusal(s, verb):
    """True (and explains) if the session is waiting on a prompt and must not be
    typed at. Text sent to a `waiting` session is consumed by whatever dialog is
    up — it answers a question or picks a permission option. Never silent."""
    if s.get("status") != "waiting":
        return False
    p = _pending(s)
    print(c("33;1", f"{s.get('name')} is WAITING — {_pending_line(p)}"))
    if p and p["kind"] == "question":
        print(c("33", "  Anything sent now becomes kaolin's answer to that question."))
        print(c("2",  "  Relay the question to him; send his real answer with --force."))
    else:
        print(c("33", "  Text sent now can select an option in the permission dialog."))
        print(c("2",  "  He has to clear it in the session's Space first."))
    print(c("2", f"  --force to {verb} anyway."))
    return True


# Named keys for `crew keys`. A checkbox list can't be driven any other way:
# digits do nothing, and `tell` appends Enter which submits a half-filled form.
_KEYS = {
    "space": " ", "enter": "\r", "return": "\r", "tab": "\t", "esc": "\x1b",
    "up": "\x1b[A", "down": "\x1b[B", "right": "\x1b[C", "left": "\x1b[D",
}


def cmd_keys(a):
    """Send raw keystrokes to a session without submitting.

    `crew keys disasteroids-bc space down down space enter`
    Anything not a named key is typed literally. Use for multi-select pickers;
    for ordinary prompts use `tell`."""
    s, tty = _pick(a.name)
    if not s:
        return
    if s.get("status") == "waiting" and not a.force:
        p = _pending(s)
        print(c("33;1", f"{s.get('name')} is WAITING — {_pending_line(p)}"))
        print(c("2", "  keys is how you answer it; pass --force once you've read the screen."))
        return
    ad = adapter_for(tty)
    sent = []
    for tok in a.key:
        chunk = _KEYS.get(tok.lower(), tok)
        if not ad.keys(tty, chunk):
            print(f"{s.get('name')} not reachable via {ad.name} (tty {tty}) — sent {sent}")
            return
        sent.append(tok)
        time.sleep(a.delay)
    print(f"→ sent {sent} to {s.get('name')} ({proj(s.get('cwd'))})")


def cmd_pending(a):
    """What every blocked session needs from kaolin — the whole point of the hub.

    Without a name: every waiting session at once, so nothing sits unnoticed
    (orrery burned 1h40m on an unseen question, 2026-07-31)."""
    if a.name:
        s, _ = _pick(a.name)
        if not s:
            return
        rows = [s]
    else:
        rows = [x for x in (load(include_all=True) or [])
                if x.get("status") == "waiting" and x.get("name") not in ("hub",)]
    if not rows:
        print("nothing waiting — no session is blocked on you.")
        return
    for s in rows:
        p = _pending(s)
        head = c("1", f"{s.get('name')}") + c("2", f"  ({proj(s.get('cwd'))})")
        print(f"\n{head}")
        if not p:
            # Claude Code doesn't always log the pending tool_use before asking,
            # so fall back to what's literally on the terminal (found live,
            # 2026-08-01: sandpainting waiting with a clean transcript tail).
            print("  " + c("2", "nothing pending in the transcript — scraping the screen:"))
            scr = _screen_tail(s, lines=a.lines)
            if scr:
                for ln in scr:
                    print("    " + ln)
            else:
                print("    " + c("2", "(not reachable — look at its Space directly)"))
            continue
        if p["kind"] == "question":
            print("  " + c("33;1", "QUESTION FOR YOU"))
            print("  " + p["detail"])
            for i, o in enumerate(p["options"], 1):
                print("    " + c("36", f"{i}. {o}"))
            print("  " + c("2", "answer with: crew tell --force " + str(s.get("name")) + " \"<answer>\""))
        else:
            print("  " + c("33", f"permission prompt: {p['tool']}"))
            print("  " + p["detail"])
            print("  " + c("2", "you have to approve/deny this in its Space — do not type at it."))
    print()


def cmd_at_prompt(a):
    """Exit 0 when the session is typeable right now. Lets the pinger tell a
    genuinely hung session from one that is only 'busy' because a background
    shell outlived the turn.

    Exit codes are load-bearing — callers poll this in a loop:
      0  typeable now
      1  exists, but mid-turn — keep waiting
      2  NO SUCH SESSION — stop waiting, it is never coming back
      3  COULD NOT LOOK — screen locked, no verdict; do not treat as hung

    Anything polling `until at-prompt` must treat 2 as fatal. A watcher that
    lumps 2 in with 1 waits forever on a name that no longer exists: a session
    renamed disasteroids-bc -> disasteroids-b3 and a queued relay sat undeliverd
    for an hour, silently (2026-08-08)."""
    s, _ = _pick(a.name)
    if not s:
        print(f"{a.name}: no such session", file=sys.stderr)
        sys.exit(2)
    if not _probes_ok():
        print(f"{s.get('name')}: cannot look — screen locked and Apple Events are crawling", file=sys.stderr)
        sys.exit(3)
    rows = _screen_tail(s, lines=12)
    ready = at_prompt(s, rows)
    shown = prompt_text(s, rows)
    if ready and shown:
        # Unverified: could be his typing or Claude Code's ghost suggestion.
        print(f"{s.get('name')}: at prompt (input line shows, unverified: {shown!r})")
        sys.exit(0)
    print(f"{s.get('name')}: " + ("at prompt" if ready else "not at prompt"))
    sys.exit(0 if ready else 1)


def _one_line(msg):
    """A typed prompt cannot contain newlines: each one is an Enter, so a
    multi-line message lands as several prompts and drops characters at the
    boundaries (orrery, 2026-09-04: "mber somewhere easy to see though").
    Collapse them and say so."""
    if "\n" not in msg:
        return msg
    flat = " ¶ ".join(p.strip() for p in msg.splitlines() if p.strip())
    print("note: newlines collapsed to ' ¶ ' — a typed prompt submits on every line break")
    return flat


def cmd_tell(a):
    s, tty = _pick(a.name)
    if not s:
        return
    if not a.force and _blocked_refusal(s, "send"):
        return
    if s.get("status") == "busy" and not a.force and not at_prompt(s):
        print(f"{s.get('name')} is busy (mid-turn). --force to send anyway (it'll queue).")
        return
    ad = adapter_for(tty)
    ok = ad.tell(tty, _one_line(a.message))
    print(f"→ sent to {s.get('name')} ({proj(s.get('cwd'))})" if ok
          else f"{s.get('name')} not reachable via {ad.name} (tty {tty})")


def cmd_ask(a):
    """Send a prompt and wait for the reply — a synchronous round-trip to a session."""
    s, tty = _pick(a.name)
    if not s:
        return
    if not a.force and _blocked_refusal(s, "ask"):
        return
    if s.get("status") == "busy" and not a.force and not at_prompt(s):
        print(f"{s.get('name')} is busy (mid-turn). --force to queue behind its current turn.")
        return
    ad = adapter_for(tty)
    before = _jsonl_lines(s)
    if not ad.tell(tty, _one_line(a.message)):
        print(f"couldn't send to {s.get('name')} via {ad.name} (tty {tty})")
        return
    print(c("2", f"→ asked {s.get('name')}; waiting for the reply (Ctrl-C to stop)…"))
    sid = s.get("sessionId")
    deadline = time.time() + a.timeout
    active, quiet, last = False, 0, before
    while time.time() < deadline:
        time.sleep(1.5)
        live = _session_now(sid) or {}
        st, wf = live.get("status"), live.get("waitingFor")
        lines = _jsonl_lines(s)
        if st == "waiting" and wf:
            print(c("33", f"⚠ {s.get('name')} is now waiting on: {wf} — stopping here."))
            break
        if st == "busy" or lines > last:
            active, quiet = True, 0
        elif active and st in ("idle", "waiting", "completed"):
            quiet += 1
            if quiet >= 2:            # settled: idle + no new output for ~3s
                break
        last = lines
    else:
        print(c("33", f"⚠ timed out after {a.timeout}s — reply so far:"))
    replies = _assistant_since(s, before)
    print(c("1", f"\n{s.get('name')} ›"))
    if replies:
        body = "\n".join(replies)
        print("  " + (body if len(body) <= 2000 else body[:2000] + c("2", " …")).replace("\n", "\n  "))
    else:
        print(c("2", "  (no reply captured yet — try `crew peek` in a moment)"))


def cmd_jump(a):
    s, tty = _pick(a.name)
    if not s:
        return
    spaces = _spaces()
    # Prefer where the window ACTUALLY is (winspace); fall back to its tagged home.
    sp = _window_space_for_session(s, tty, spaces) or _space_for_session(s, spaces)
    if sp and sp.get("uuid"):
        subprocess.run([_spacetag_bin(), "goto", str(sp["uuid"])])
    ad = adapter_for(tty)
    ok = ad.jump(tty)
    if sp and sp.get("index"):
        where = f"  (Space {sp['index']}" + (f" · {sp['tag']}" if sp.get("tag") else "") + ")"
    elif sp:
        where = "  (Space set)"
    else:
        where = "  (no Space match — same-Space select only)"
    print(f"jumped to {s.get('name')}{where}" if ok
          else f"{s.get('name')} not reachable via {ad.name} (tty {tty})")


def cmd_where(a):
    s, tty = _pick(a.name)
    if not s:
        return
    spaces = _spaces()
    actual = _window_space_for_session(s, tty, spaces)
    intended = _space_for_session(s, spaces)

    def fmt(sp):
        if not sp:
            return c("2", "—")
        return f"Space {sp.get('index')}" + (f" · {sp['tag']}" if sp.get("tag") else "")

    print(c("1", f"\n  {s.get('name')}   ({proj(s.get('cwd'))})\n"))
    print(f"  actual    (window is on)   {fmt(actual)}")
    print(f"  intended  (tag mapping)    {fmt(intended)}")
    print()


def cmd_goto(a):
    sessions = load(a.source)
    matches = _resolve(sessions, a.name)
    if not matches:
        print(f"no running session matches '{a.name}'")
        return
    if len(matches) > 1:
        print(f"'{a.name}' is ambiguous — matches:")
        for m in matches:
            print(f"    {m.get('name')}   {proj(m.get('cwd'))}   [{m.get('status')}]")
        return
    s = matches[0]
    spaces = _spaces(a.spaces_source)
    if not spaces:
        print("no Spaces from `spacetag dump` — is the pro build present? (set CREW_SPACETAG to override)")
        return
    sp = _space_for_session(s, spaces)
    if not sp:
        print(f"no Space tag matches {s.get('name')} ({proj(s.get('cwd'))}).")
        print(f"add ~/.crew/space_aliases.json, e.g. {{\"{proj(s.get('cwd'))}\": \"<tag, index, or uuid>\"}}")
        return
    print(f"{s.get('name')} → Space {sp.get('index')} · {sp.get('tag')}")
    if a.dry_run:
        return
    subprocess.run([_spacetag_bin(), "goto", str(sp["uuid"])])
    tty = _tty_of(s.get("pid"))
    if tty:
        adapter_for(tty).jump(tty)


