                waits.append((name, d, blockers))
            else:
                quiet.append((name, d, d.get("last_action") or d.get("summary") or ""))

        if moves:
            print(C("35;1", "NEEDS KAOLIN — %d" % len(moves)))
            for name, d, items in moves:
                print("  %s  %s" % (C("1", name), C("2", _age(d.get("updated_at")))))
                for it in items:
                    print("     · %s" % str(it)[:160])
            print("")
        if waits:
            print(C("33;1", "BLOCKED ON SOMETHING ELSE — %d" % len(waits)))
            for name, d, items in waits:
                print("  %s  %s" % (C("1", name), C("2", _age(d.get("updated_at")))))
                for it in items:
                    print("     · %s" % str(it)[:160])
            print("")
        if quiet:
            print(C("32", "QUIET — %d" % len(quiet)))
            for name, d, line in quiet:
                print("  %-16s %-9s %s" % (name, _age(d.get("updated_at")), str(line)[:100]))
            print("")

        # Commit records (hooks/crew-hook.py) are exact where the status file is
        # the session's own claim: the real HEAD behind a stale device, and how
        # many commits landed after the file was written.
        recs = _commit_records()

        stale = [(n, d) for n, d in files
                 if isinstance(d.get("device"), dict) and d["device"].get("stale")]
        if stale:
            print(C("31;1", "DEVICE STALE — kaolin may be testing code that no longer exists"))
            for n, d in stale:
                dev = d["device"]
                head = str(d.get("head", "?"))
                latest, _ = _commits_since(n, d, recs)
                if latest and not head.startswith(latest["sha"][:7]):
                    head += " (latest commit %s · %s)" % (latest["sha"][:7], _age(latest.get("ts")))
                print("  %-16s %s: shipped %s vs head %s" %
                      (n, dev.get("name", "?"), dev.get("shipped_commit", "?"), head))
            print("")

        # A session that writes `unpushed` as a string ("origin=github.com/…")
        # was printed one character per item (spacetag, 2026-09-03).
        unpushed = [(n, d, _listish(d, "unpushed")) for n, d in files if _listish(d, "unpushed")]
        if unpushed:
            print(C("36", "UNPUSHED WORK"))
            for n, d, u in unpushed:
                print("  %-16s %s" % (n, ", ".join(str(x) for x in u)[:100]))
                latest, newer = _commits_since(n, d, recs)
                if newer:
                    print("  %-16s +%d commit(s) since this status, latest %s %s" %
                          ("", newer, latest["sha"][:7], str(latest.get("subject") or "")[:60]))
            print("")

        # Everything above is only as true as the file is recent. A status file
        # nobody has touched in a day — or that commits have landed after —
        # describes a session that has since done work it does not mention:
        # read it as history, and `crew peek` the session (or
        # `crew status-refresh --stale`) for now.
        old = []
        for n, d in files:
            secs = _age_secs(d.get("updated_at"))
            latest, newer = _commits_since(n, d, recs)
            if secs is not None and secs > STATUS_STALE_SECS:
                old.append((n, _age(d.get("updated_at"))
                            + (" · %d commit(s) after it" % newer if newer else "")))
            elif newer:
                old.append((n, "%d commit(s) after it, latest %s · %s" %
                            (newer, latest["sha"][:7], _age(latest.get("ts")))))
        if old:
            print(C("33;1", "STALE STATUS FILES — %d (older than a day, or commits since; "
                            "peek the session instead)" % len(old)))
            for n, ag in old:
                print("  %-16s %s" % (n, ag))
            print("")

    if not a.no_ack and mx > since:
        os.makedirs(STATUS_DIR, exist_ok=True)
        tmp = BRIEF_CURSOR + ".tmp"
        io.open(tmp, "w").write(str(mx) + "\n")
        os.replace(tmp, BRIEF_CURSOR)


# --- status-refresh: a headless summarizer writes the status file ------------
# Sessions are asked to write ~/.claude/status/<name>.json at the end of every
# turn, and the ones that forget leave the hub reading week-old files (7 of 13
# were over a day old on 2026-09-08). This runs `claude -p` (haiku, one call)
# with hub/summarizer.md — previous status + git log + unpushed count + the
# transcript tail — and asks for the SAME schema, so brief and the pinger keep
# working. The file is also mirrored into <project>/.crew/status.json (excluded
# via .git/info/exclude, never committed) so the project carries its own state.
# Scheduling is OFF by default; README says how to turn it on and what it costs.
REPO_DIR = os.path.dirname(os.path.realpath(globals().get("__file__") or sys.argv[0]))
SUMMARIZER_PROMPT     = os.path.join(REPO_DIR, "hub", "summarizer.md")
REFRESH_STATE         = os.path.join(SNAP_DIR, "status-refresh.json")   # {cwd: {last_run, name, changed}}
REFRESH_COOLDOWN_SECS = 15 * 60
REFRESH_MODEL         = "haiku"
REFRESH_TAIL_LINES    = 200        # transcript lines fed to the summarizer
REFRESH_TAIL_CHARS    = 60_000     # ...after rendering to USER/ASSISTANT turns
REFRESH_TURN_CHARS    = 3_000      # per turn; a pasted build log is not status
REFRESH_TIMEOUT_SECS  = 240
REFRESH_EXCLUDE       = {"hub"}    # never summarize the hub, or anything rooted at $HOME


def _status_name_for(s):
    """Which ~/.claude/status/<name>.json a session owns. Existing files win:
    `thereby-8e` → thereby.json, `[claude] erif_html` → erif.json (prefix).
    A project with no file yet gets its directory name, lowercased."""
    shown = (s.get("name") or "").replace("[claude] ", "", 1)
    stem = re.sub(r"-[0-9a-z]{2}$", "", shown)
    cands = [c for c in (stem, stem.lower(), proj(s.get("cwd")).lower(), proj(s.get("cwd"))) if c]
    existing = [n for n, _ in _status_files()]
    for c in cands:
        if c in existing:
            return c
    for c in cands:
        for n in existing:
            if len(n) >= 4 and _slug(c).startswith(_slug(n)):
                return n
    return proj(s.get("cwd")).lower() or stem.lower() or "session"


def _transcript_tail(s, lines=REFRESH_TAIL_LINES, chars=REFRESH_TAIL_CHARS):
    """The last `lines` transcript records rendered as USER:/ASSISTANT: turns,
    newest last, clipped per turn and in total (from the old end)."""
    try:
        with open(_jsonl_path(s), errors="ignore") as f:
            raw = f.readlines()[-lines:]
    except Exception:
        return ""
    out = []
    for role, text in _parse_turns(raw):
        t = text if len(text) <= REFRESH_TURN_CHARS else text[:REFRESH_TURN_CHARS] + " …[clipped]"
        out.append("%s: %s" % (role.upper(), t))
    text = "\n\n".join(out)
    return text if len(text) <= chars else "…[older turns clipped]\n" + text[-chars:]


def _git(cwd, *args, timeout=10):
    try:
        out = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=timeout,
                             env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    except Exception:
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def _git_facts(cwd):
    """{repo, log, head, unpushed} for the summarizer. `unpushed` is an int, or
    a sentence when there is no upstream or no repo."""
    top = _git(cwd, "rev-parse", "--show-toplevel") if cwd and os.path.isdir(cwd) else None
    if not top:
        return {"repo": None, "log": "(not a git repo)", "head": None, "unpushed": "not a git repo"}
    log = _git(top, "log", "--oneline", "-20") or "(no commits)"
    head = _git(top, "rev-parse", "--short", "HEAD")
    n = _git(top, "rev-list", "--count", "@{u}..HEAD")
    unpushed = int(n) if (n or "").isdigit() else "no upstream configured (every commit is local-only)"
    return {"repo": top, "log": log, "head": head, "unpushed": unpushed}


def _build_prompt(session_label, cwd, prev, git, tail, now_iso):
    tpl = io.open(SUMMARIZER_PROMPT, encoding="utf-8").read()
    for k, v in (("SESSION", session_label), ("PROJECT", cwd or "?"), ("NOW", now_iso),
                 ("PREVIOUS_STATUS", json.dumps(prev, indent=2, ensure_ascii=False) if prev else "{}"),
                 ("GIT_LOG", git["log"]), ("UNPUSHED", str(git["unpushed"])),
                 ("TRANSCRIPT_TAIL", tail or "(no transcript)")):
        tpl = tpl.replace("{{%s}}" % k, v)
    return tpl


def _extract_json(text):
    """The first {...} object in a model reply, fences or not. None if none parses."""
    if not isinstance(text, str):
        return None
    t = text.strip()
    if t.startswith("```"):
        t = re.sub(r"^```[a-zA-Z]*\s*", "", t); t = re.sub(r"\s*```$", "", t)
    a, b = t.find("{"), t.rfind("}")
    if a < 0 or b <= a:
        return None
    try:
        d = json.loads(t[a:b + 1])
    except Exception:
        return None
    return d if isinstance(d, dict) else None


def _run_summarizer(prompt, cwd, model):
    """One headless call. Returns (status_dict, meta, error). `--tools ""` and
    `--max-turns 1`: it reads what it is given and answers; nothing runs."""
    cmd = [_claude_bin(), "-p", "--model", model, "--output-format", "json",
           "--tools", "", "--max-turns", "1", "--no-session-persistence"]
    env = {k: v for k, v in os.environ.items() if k not in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT")}
    try:
        out = subprocess.run(cmd, input=prompt, capture_output=True, text=True,
                             cwd=cwd if cwd and os.path.isdir(cwd) else None,
                             timeout=REFRESH_TIMEOUT_SECS, env=env)
    except subprocess.TimeoutExpired:
        return None, {}, "claude -p timed out after %ds" % REFRESH_TIMEOUT_SECS
    except OSError as e:
        return None, {}, "could not run claude: %s" % e
    if out.returncode != 0:
        return None, {}, "claude -p exited %d: %s" % (out.returncode, (out.stderr or out.stdout).strip()[:300])
    try:
        env_ = json.loads(out.stdout)
    except Exception:
        return None, {}, "claude -p did not return JSON: %s" % out.stdout.strip()[:200]
    if not isinstance(env_, dict):
        return None, {}, "unexpected output shape"
    meta = {"model": model, "session_id": env_.get("session_id"),
            "cost_usd": env_.get("total_cost_usd"), "duration_ms": env_.get("duration_ms"),
            "num_turns": env_.get("num_turns"), "usage": env_.get("usage")}
    if env_.get("is_error"):
        return None, meta, "claude -p reported an error: %s" % str(env_.get("result"))[:300]
    d = _extract_json(env_.get("result"))
    if d is None:
        return None, meta, "no JSON object in the reply: %s" % str(env_.get("result"))[:200]
    return d, meta, None


def _comparable(d):
    return {k: v for k, v in (d or {}).items() if k not in ("updated_at", "updated", "refreshed")}


def _write_json_atomic(path, d):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with io.open(tmp, "w", encoding="utf-8") as f:
        json.dump(d, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def _mirror_status(repo, d):
    """<repo>/.crew/status.json, with `.crew/` in .git/info/exclude — never
    .gitignore (that is a change to their tree), never a commit. Returns the
    mirror path, or None when the project is not a git repo."""
    if not repo:
        return None
    excl = _git(repo, "rev-parse", "--git-path", "info/exclude")
    if excl:
        excl = excl if os.path.isabs(excl) else os.path.join(repo, excl)
        try:
            os.makedirs(os.path.dirname(excl), exist_ok=True)
            lines = io.open(excl, encoding="utf-8").read().splitlines() if os.path.exists(excl) else []
            if ".crew/" not in [l.strip() for l in lines]:
                with io.open(excl, "a", encoding="utf-8") as f:
                    f.write(("" if not lines or lines[-1] == "" else "\n") + ".crew/\n")
        except OSError:
            pass
    path = os.path.join(repo, ".crew", "status.json")
    _write_json_atomic(path, d)
    return path


def _load_refresh_state():
    try:
        return json.load(io.open(REFRESH_STATE, encoding="utf-8"))
    except Exception:
        return {}


def _stale_reason(name, d, recs, st):
    """Why a session's status should be refreshed, or None. Fresh means either
    the file or the last (possibly unchanged) refresh is recent, with no commit
    after both."""
    if not d:
        return "no status file"
    last_run = (st or {}).get("last_run") or 0
    ages = [x for x in (_age_secs(d.get("updated_at") or d.get("updated")),
                        (time.time() - last_run) if last_run else None) if x is not None]
    eff_age = min(ages) if ages else None
    latest, newer = _commits_since(name, d, recs)
    if latest and last_run and (latest.get("t") or 0) <= last_run:
        newer = 0                      # already summarized after that commit
    if newer:
        return "%d commit(s) after the status (latest %s)" % (newer, latest["sha"][:7])
    if eff_age is None:
        return "status has no readable updated_at"
    if eff_age > STATUS_STALE_SECS:
        return "status %s old" % _age(d.get("updated_at") or d.get("updated"))
    return None


def refresh_one(s, model=REFRESH_MODEL, dry_run=False, quiet=False):
    """Summarize one session into its status file (+ mirror). Returns
    'changed' | 'unchanged' | 'dry-run' | 'error'."""
    cwd = s.get("cwd") or ""
    name = _status_name_for(s)
    path = os.path.join(STATUS_DIR, name + ".json")
    try:
        prev = json.load(io.open(path, encoding="utf-8"))
    except Exception:
        prev = {}
    git = _git_facts(cwd)
    tail = _transcript_tail(s)
    now_iso = datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
    label = (s.get("name") or "").replace("[claude] ", "", 1) or name
    prompt = _build_prompt(prev.get("session") or label, cwd, prev, git, tail, now_iso)
    shown = s.get("name") or name
    if dry_run:
        print("%s → %s%s" % (shown, path, ("  (+ mirror in %s/.crew/)" % git["repo"]) if git["repo"] else "  (no git repo: no mirror)"))
        print("   prompt %d chars: status %d, git log %d lines, unpushed %s, transcript %d chars; model %s — not sent"
              % (len(prompt), len(json.dumps(prev)), len(git["log"].splitlines()), git["unpushed"], len(tail), model))
        return "dry-run"
    new, meta, err = _run_summarizer(prompt, cwd, model)
    if err:
        print("%s: %s" % (shown, err))
        return "error"
    # Identity and clock are ours, not the model's: the file must keep naming
    # the session it always did (brief and the pinger key on it), and be dated
    # by the run, not by whatever the model copied.
    new["session"] = prev.get("session") or label
    new["updated_at"] = now_iso
    new.pop("updated", None)
    if git["head"]:
        new["head"] = git["head"]
    new["refreshed"] = {"by": "crew status-refresh", "model": model, "at": now_iso,
                        "cost_usd": meta.get("cost_usd"), "claude_session": meta.get("session_id")}
    st = _load_refresh_state()
    changed = [k for k in sorted(set(_comparable(new)) | set(_comparable(prev)))
               if _comparable(new).get(k) != _comparable(prev).get(k)]
    cost = ("$%.4f" % meta["cost_usd"]) if isinstance(meta.get("cost_usd"), (int, float)) else "cost n/a"
    if not changed and prev:
        st[cwd] = {"last_run": time.time(), "name": name, "changed": False}
        _write_json_atomic(REFRESH_STATE, st)
        print("%s: unchanged (%s, %s) — not rewritten" % (shown, model, cost))
        return "unchanged"
    _write_json_atomic(path, new)
    mirror = _mirror_status(git["repo"], new)
    st[cwd] = {"last_run": time.time(), "name": name, "changed": True}
    _write_json_atomic(REFRESH_STATE, st)
    print("%s → %s  (%s, %s)  changed: %s" % (shown, path, model, cost, ", ".join(changed)[:200] or "-"))
    print("   mirror: %s" % mirror if mirror else "   no git repo: mirror skipped")
    return "changed"


def cmd_status_refresh(a):
    if not os.path.exists(SUMMARIZER_PROMPT):
        print("missing prompt %s" % SUMMARIZER_PROMPT); sys.exit(1)
    try:
        sessions = load(a.source)
    except Exception as e:
        print("could not list sessions: %s" % e); sys.exit(1)
    fleet = [s for s in sessions
             if (s.get("name") or "").replace("[claude] ", "", 1) not in REFRESH_EXCLUDE
             and (s.get("cwd") or "").rstrip("/") != HOME.rstrip("/")
             and s.get("status") not in ("completed", "stopped", "failed")]
    if not a.target and not a.stale:
        print("usage: crew status-refresh <name|all> | --stale   (add --dry-run to see the prompt size and targets)")
        sys.exit(2)
    if a.target == "all":
        targets, cooldown = fleet, True
    elif a.target == "--stale" or a.stale:
        recs, st = _commit_records(), _load_refresh_state()
        targets, cooldown = [], True
        for s in fleet:
            name = _status_name_for(s)
            try:
                d = json.load(io.open(os.path.join(STATUS_DIR, name + ".json"), encoding="utf-8"))
            except Exception:
                d = {}
            why = _stale_reason(name, d, recs, st.get(s.get("cwd") or ""))
            if why:
                print("stale: %-18s %s" % (s.get("name"), why))
                targets.append(s)
        if not targets:
            print("nothing stale — every status file is under a day old, refreshed recently, and has no commit after it")
            return
    else:
        hit = _resolve(sessions, a.target)
        if not hit:
            print("no running session matches %r" % a.target); sys.exit(1)
        if len(hit) > 1:
            print("%r is ambiguous: %s" % (a.target, ", ".join(s.get("name") or "?" for s in hit))); sys.exit(1)
        targets, cooldown = hit, False
    st = _load_refresh_state()
    results = {}
    for s in targets:
        last = (st.get(s.get("cwd") or "") or {}).get("last_run") or 0
        if cooldown and (time.time() - last) < REFRESH_COOLDOWN_SECS and not a.dry_run:
            print("%s: refreshed %s — cooling down (%d min)" % (
                s.get("name"), _age(datetime.datetime.fromtimestamp(last).astimezone().isoformat()),
                REFRESH_COOLDOWN_SECS // 60))
            results["cooldown"] = results.get("cooldown", 0) + 1
            continue
        r = refresh_one(s, model=a.model, dry_run=a.dry_run)
        results[r] = results.get(r, 0) + 1
    if len(targets) > 1 or results.get("cooldown"):
        print(", ".join("%d %s" % (n, k) for k, n in sorted(results.items())))
    if results.get("error") and not results.get("changed") and not results.get("unchanged"):
        sys.exit(1)


# --- Claude Code hooks -------------------------------------------------------
# The pinger infers "finished" and "needs you" from transcripts and a screen
# scrape. Claude Code's own hooks state both as facts. `crew hooks install`
# merges three entries into ~/.claude/settings.json that run hooks/crew-hook.py
# (append-only, exit 0, silent) — see pinger/tick.py "hook events" for how they
# are preferred. A global settings write once gated every session on this Mac,
# so install prints exactly what it would add and refuses without --yes.
SETTINGS_PATH = os.path.join(HOME, ".claude", "settings.json")
HOOK_TIMEOUT_SECS = 5      # the handler takes ~30 ms; git attribution ~150 ms


def _hook_script():
    """Absolute path to the handler beside this script (through any symlink)."""
    here = os.path.dirname(os.path.realpath(globals().get("__file__") or sys.argv[0]))
    return os.path.join(here, "hooks", "crew-hook.py")


def hook_entries(script=None):
    """The `hooks` block install merges. Notification and Stop take no matcher
    (Stop has none; Notification's would filter by type, and the pinger does
    that itself); PostToolUse is limited to Bash, the only tool whose command
    can be a `git commit`."""
    cmd = script or _hook_script()
    one = {"type": "command", "command": cmd, "timeout": HOOK_TIMEOUT_SECS}
    return {
        "Notification": [{"hooks": [dict(one)]}],
        "Stop":         [{"hooks": [dict(one)]}],
        "PostToolUse":  [{"matcher": "Bash", "hooks": [dict(one)]}],
    }


def _hook_present(settings, event, group, cmd):
    """Is a command hook for `cmd` already in settings under `event` with the
    same matcher? Idempotence key: (event, matcher, command)."""
    for g in (settings.get("hooks") or {}).get(event) or []:
        if not isinstance(g, dict) or (g.get("matcher") or "") != (group.get("matcher") or ""):
            continue
        for h in g.get("hooks") or []:
            if isinstance(h, dict) and h.get("type") == "command" and h.get("command") == cmd:
                return True
    return False


def merge_hooks(settings, entries, cmd):
    """Return (new_settings, added) — settings with any missing crew entries
    appended. Existing hooks of any kind are left exactly as they were."""
    out = json.loads(json.dumps(settings))
    hooks = out.setdefault("hooks", {})
    added = []
    for event, groups in entries.items():
        for g in groups:
            if _hook_present(out, event, g, cmd):
                continue
            hooks.setdefault(event, []).append(g)
            added.append(event)
    return out, added


def unmerge_hooks(settings, cmd):
    """Return (new_settings, removed) — crew's command hooks taken out, empty
    groups/events/`hooks` pruned, everything else untouched."""
    out = json.loads(json.dumps(settings))
    removed = []
    hooks = out.get("hooks") or {}
    for event in list(hooks):
        kept = []
        for g in hooks[event] or []:
            if not isinstance(g, dict):
                kept.append(g); continue
            hs = [h for h in (g.get("hooks") or [])
                  if not (isinstance(h, dict) and h.get("type") == "command" and h.get("command") == cmd)]
            if len(hs) != len(g.get("hooks") or []):
                removed.append(event)
            if hs:
                kept.append({**g, "hooks": hs})
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    if not hooks and "hooks" in out:
        del out["hooks"]
    return out, removed


def _read_settings():
    try:
        return json.load(io.open(SETTINGS_PATH, encoding="utf-8"))
    except OSError:
        return {}


def _write_settings(d):
    """Atomic, with a timestamped backup beside it. This file gates every session."""
    os.makedirs(os.path.dirname(SETTINGS_PATH), exist_ok=True)
    if os.path.exists(SETTINGS_PATH):
        bak = SETTINGS_PATH + ".bak-" + time.strftime("%Y%m%d-%H%M%S")
        n = 1
        while os.path.exists(bak):          # two writes in one second keep both backups
            n += 1
            bak = SETTINGS_PATH + ".bak-" + time.strftime("%Y%m%d-%H%M%S") + "-%d" % n
        shutil.copy2(SETTINGS_PATH, bak)
    tmp = SETTINGS_PATH + ".tmp"
    with io.open(tmp, "w", encoding="utf-8") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    os.replace(tmp, SETTINGS_PATH)


def cmd_hooks(a):
    cmd = _hook_script()
    entries = hook_entries(cmd)
    settings = _read_settings()
    if a.action == "status":
        ok = os.path.isfile(cmd) and os.access(cmd, os.X_OK)
        print("handler  %s  %s" % (cmd, "ok" if ok else "MISSING or not executable"))
        print("settings %s" % SETTINGS_PATH)
        for event, groups in entries.items():
            present = all(_hook_present(settings, event, g, cmd) for g in groups)
            print("  %-13s %s" % (event, "installed" if present else "not installed"))
        log = os.path.join(STATUS_DIR, "_hooks.jsonl")
        try:
            n = sum(1 for _ in io.open(log, encoding="utf-8", errors="replace"))
            print("log      %s  %d event(s)" % (log, n))
        except OSError:
            print("log      %s  (none yet — sessions started before install write nothing)" % log)
        return
    if a.action == "install":
        merged, added = merge_hooks(settings, entries, cmd)
        print("would add to %s:" % SETTINGS_PATH)
        print(json.dumps({"hooks": {e: g for e, g in entries.items() if e in added}} if added else {}, indent=2))
        if not added:
            print("nothing to do — all three are already installed")
            return
        if not a.yes:
            print("refusing: this edits a global settings file that every session reads. "
                  "Review the JSON above, then re-run with --yes.")
            sys.exit(2)
        if not (os.path.isfile(cmd) and os.access(cmd, os.X_OK)):
            print("refusing: handler %s is missing or not executable" % cmd)
            sys.exit(1)
        _write_settings(merged)
        print("installed %s (backup beside it). Running sessions pick hooks up when Claude Code "
              "notices the file change; otherwise on their next restart." % ", ".join(added))
        return
    if a.action == "uninstall":
        pruned, removed = unmerge_hooks(settings, cmd)
        if not removed:
            print("nothing to remove — no crew hooks in %s" % SETTINGS_PATH)
            return
        print("would remove crew's hooks from %s: %s" % (SETTINGS_PATH, ", ".join(removed)))
        if not a.yes:
            print("refusing without --yes")
            sys.exit(2)
        _write_settings(pruned)
        print("removed %s (backup beside it)" % ", ".join(removed))


def cmd_tg_patch(a):
    """Check -- and with --apply, restore -- the local telegram server.ts patch."""
    versions = _tg_plugin_versions()
    if not versions:
        print("no telegram plugin found under " + TG_PLUGIN_DIR)
        return

    need = []
    for v in versions:
        sp, missing = _tg_patch_state(v)
        if missing is None:
            print("  %s: no server.ts" % v)
        elif missing:
            print("  %s: REVERTED -- missing %s" % (v, ", ".join(missing)))
            need.append((v, sp))
        else:
            print("  %s: patched" % v)

    if not need:
        print("all installed versions carry the patch")
        return
    if not a.apply:
        print("")
        print("re-apply with: crew tg-patch --apply")
        return

    patch = os.path.join(TG_PATCH_DIR, "local.patch")
    inbound = os.path.join(TG_PATCH_DIR, "inbound-log.ts")
    if not os.path.exists(patch):
        print("missing %s -- cannot re-apply" % patch)
        return

    for v, sp in need:
        vdir = os.path.dirname(sp)
        shutil.copy2(sp, sp + ".orig-" + v)
        if os.path.exists(inbound):
            shutil.copy2(inbound, os.path.join(vdir, "inbound-log.ts"))
        with io.open(patch) as fh:
            r = subprocess.run(["patch", "-p0", "-N", sp], stdin=fh,
                               capture_output=True, text=True)
        if r.returncode != 0:
            print("  %s: FAILED -- %s" % (v, (r.stderr or r.stdout).strip()[:200]))
            continue
        _, missing = _tg_patch_state(v)
        if missing:
            print("  %s: applied but still missing %s -- inspect by hand"
                  % (v, ", ".join(missing)))
        else:
            print("  %s: applied (stock kept as server.ts.orig-%s)" % (v, v))

    print("")
    print("Takes effect only on a NEW poller. /reload-plugins does NOT restart it:")
    print("quit and reopen the session, or kill the bot.pid process from a")
    print("terminal that does not need the channel.")
    pid = _tg_running_poller()
    if pid:
        print("current poller: pid %d" % pid)


def main():
    ap = argparse.ArgumentParser(prog="crew", description="read-only status + restore for your Claude sessions")
    ap.set_defaults(fn=cmd_status, source=None, all=False, go=False, out=None)
    sub = ap.add_subparsers(dest="cmd")
    ps = sub.add_parser("status", help="project-grouped status view (default)")
    ps.add_argument("--source", help="read JSON from a file or '-' for stdin instead of `claude agents --json`")
    ps.add_argument("--all", action="store_true", help="include completed sessions")
    ps.set_defaults(fn=cmd_status)
    par = sub.add_parser("artifacts", help="gallery of every live artifact URL across your fleet")
    par.add_argument("--all", action="store_true", help="include completed sessions")
    par.add_argument("--limit", type=int, default=5, help="max artifacts per session")
    par.set_defaults(fn=cmd_artifacts)
    pn = sub.add_parser("snapshot", help="save current sessions as a restore manifest")
    pn.add_argument("--source")
    pn.add_argument("--out", help=f"manifest path (default {SNAP_DIR}/latest.json)")
    pn.add_argument("--force", action="store_true", help="write even an empty read (default: keep last good map)")
    pn.add_argument("--spaces-source", dest="spaces_source", help="spaces JSON (testing; default: live `spacetag dump`)")
    pn.add_argument("--verbose", action="store_true",
                    help="always print the Space drift report (non-tty runs only print it when it changes)")
    pn.set_defaults(fn=cmd_snapshot)
    pr = sub.add_parser("restore", help="resume every session from a manifest into fresh iTerm2 windows")
    pr.add_argument("--source", help=f"manifest path (default {SNAP_DIR}/latest.json)")
    pr.add_argument("--go", action="store_true", help="actually open windows (default: dry-run)")
    pr.add_argument("--as-found", dest="as_found", action="store_true",
                    help="rebuild the recorded layout verbatim; skip sending drifted windows home")
    pr.add_argument("--spaces-source", dest="spaces_source", help="spaces JSON (testing; default: live `spacetag dump`)")
    pr.add_argument("--even-locked", dest="even_locked", action="store_true",
                    help="open windows even though the screen is locked (they usually never start)")
    pr.set_defaults(fn=cmd_restore)
    plk = sub.add_parser("locked", help="is the login screen up? (exit 0 locked / 1 unlocked)")
    plk.set_defaults(fn=cmd_locked)
    prg = sub.add_parser("regression", help="Tahoe AppleScript latency: sampled log, and is a macOS update out?")
    prg.add_argument("--sample", action="store_true", help="take one measurement now")
    prg.add_argument("--check-update", dest="check_update", action="store_true", help="ask softwareupdate (network)")
    prg.set_defaults(fn=cmd_regression)
    ph = sub.add_parser("hub", help="how to restart the hub session without losing its Telegram channel")
    ph.set_defaults(fn=cmd_hub)
    ptg = sub.add_parser("tg-prune", help="delete Telegram inbox attachments older than N days (dry-run by default)")
    ptg.add_argument("--days", type=int, default=30, help="keep files newer than this many days (default 30)")
    ptg.add_argument("--go", action="store_true", help="actually delete (default: list what would go)")
    ptg.set_defaults(fn=cmd_tg_prune)
    pk = sub.add_parser("peek", help="show a session's recent conversation (read-only, any terminal)")
    pk.add_argument("name")
    pk.add_argument("--turns", type=int, default=4, help="recent turns to show (transcript mode)")
    pk.add_argument("--screen", action="store_true", help="raw terminal scrape instead of the transcript")
    pk.add_argument("--lines", type=int, default=40, help="lines to show with --screen")
    pk.set_defaults(fn=cmd_peek)
    pky = sub.add_parser("keys", help="send raw keystrokes with NO Enter (drives multi-select pickers)")
    pky.add_argument("name")
    pky.add_argument("key", nargs="+", help="space/enter/tab/up/down/left/right/esc, or literal text")
    pky.add_argument("--force", action="store_true", help="send even if the session is waiting on a prompt")
    pky.add_argument("--delay", type=float, default=0.25, help="seconds between keys")
    pky.set_defaults(fn=cmd_keys)
    pp = sub.add_parser("pending", help="what blocked sessions need from you (questions vs permission prompts)")
    pp.add_argument("name", nargs="?", help="one session; omit for every waiting session")
    pp.add_argument("--lines", type=int, default=18, help="screen lines to scrape when the transcript has nothing")
    pp.set_defaults(fn=cmd_pending)
    pap = sub.add_parser("at-prompt",
                         help="exit 0 if the session shows an empty input box (busy only from a bg task)")
    pap.add_argument("name")
    pap.set_defaults(fn=cmd_at_prompt)
    pt = sub.add_parser("tell", help="type a prompt into an idle session and submit it (fire-and-forget)")
    pt.add_argument("name")
    pt.add_argument("message")
    pt.add_argument("--force", action="store_true", help="send even if the session is busy or waiting on a prompt")
    pt.set_defaults(fn=cmd_tell)
    pa = sub.add_parser("ask", help="send a prompt and WAIT for the reply (synchronous round-trip)")
    pa.add_argument("name")
    pa.add_argument("message")
    pa.add_argument("--force", action="store_true", help="ask even if the session is busy or waiting on a prompt")
    pa.add_argument("--timeout", type=int, default=300, help="seconds to wait for the reply")
    pa.set_defaults(fn=cmd_ask)
    pj = sub.add_parser("jump", help="switch to a session's Space (via spacetag) and front its window")
    pj.add_argument("name")
    pj.set_defaults(fn=cmd_jump)
    pg = sub.add_parser("goto", help="switch to the Space a session lives on, then front it")
    pg.add_argument("name")
    pg.add_argument("--dry-run", action="store_true", help="print the resolved Space, don't switch")
    pg.add_argument("--source", help="sessions JSON (testing)")
    pg.add_argument("--spaces-source", dest="spaces_source", help="spaces JSON (testing)")
    pg.set_defaults(fn=cmd_goto)
    pw = sub.add_parser("where", help="show where a session's window actually is vs its tagged home")
    pw.add_argument("name")
    pw.set_defaults(fn=cmd_where)
    pu = sub.add_parser("setup", help="symlink crew onto PATH + install the snapshot agent")
    pu.add_argument("--dry-run", action="store_true", help="print what it would do, change nothing")
    pu.set_defaults(fn=cmd_setup)
    pl = sub.add_parser("label", help="colour every session's iTerm tab by project (and clear badges)")
    pl.add_argument("--clear", action="store_true", help="reset tab colours and badges instead")
    pl.add_argument("--no-title", dest="no_title", action="store_true",
                    help="colour only; leave claude's live window title alone")
    pl.set_defaults(fn=cmd_label)
    ps2 = sub.add_parser("doctor", help="check deps (claude, spacetag, iTerm2, PATH, agent)")
    ps2.set_defaults(fn=cmd_doctor)
    ptu = sub.add_parser("tg-unactioned", help="Telegram inbound logged but not yet confirmed actioned by the hub")
    ptu.add_argument("--all", action="store_true", help="include records older than the 48h review window")
    ptu.set_defaults(fn=cmd_tg_unactioned)
    pb = sub.add_parser("brief",
        help="wake briefing: every session's status file + unseen pinger events")
    pb.add_argument("--plain", action="store_true", help="no ANSI colour")
    pb.add_argument("--no-ack", action="store_true",
        help="do not advance the seen-cursor for pinger events")
    pb.set_defaults(fn=cmd_brief)
    ptp = sub.add_parser("tg-patch",
        help="check (or --apply) the local telegram plugin patch that updates revert")
    ptp.add_argument("--apply", action="store_true",
        help="re-apply the patch to any reverted version")
    ptp.set_defaults(fn=cmd_tg_patch)
    pta = sub.add_parser("tg-actioned", help="mark Telegram inbound handled up through <seq> (or 'latest')")
    pta.add_argument("seq", help="a seq number, or 'latest' to mark everything logged as actioned")
    pta.set_defaults(fn=cmd_tg_actioned)
    psr = sub.add_parser("status-refresh",
        help="headless summarizer (claude -p, haiku) rewrites a session's status file + mirrors it into the repo")
    psr.add_argument("target", nargs="?",
        help="a session/project name, or 'all'; or pass --stale")
    psr.add_argument("--stale", action="store_true",
        help="only sessions whose status is over a day old or has a commit after it (15 min cooldown per project)")
    psr.add_argument("--model", default=REFRESH_MODEL, help="model alias for claude -p (default %s)" % REFRESH_MODEL)
    psr.add_argument("--dry-run", dest="dry_run", action="store_true",
        help="build the prompt and say what would be written; call nothing")
    psr.add_argument("--source", help="sessions JSON (testing)")
    psr.set_defaults(fn=cmd_status_refresh)
    pcm = sub.add_parser("commits", help="commits the fleet has made (from the PostToolUse hook), newest first")
    pcm.add_argument("name", nargs="?", help="one session/project (resolves like every other command); omit for all")
    pcm.add_argument("--limit", type=int, default=20, help="rows to show (default 20)")
    pcm.add_argument("--all", action="store_true", help="every record")
    pcm.add_argument("--source", help="sessions JSON (testing)")
    pcm.set_defaults(fn=cmd_commits)
    phk = sub.add_parser("hooks",
        help="Claude Code hooks that feed the pinger facts (Notification, Stop, PostToolUse Bash)")
    phk.add_argument("action", choices=["install", "status", "uninstall"])
    phk.add_argument("--yes", action="store_true",
        help="actually write ~/.claude/settings.json (install/uninstall print the change and refuse without it)")
    phk.set_defaults(fn=cmd_hooks)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
