def _age(iso):
    """'3h ago' from an ISO timestamp, or '?' if unparseable."""
    if not iso:
        return "?"
    t = str(iso).strip().replace("Z", "+00:00")
    try:
        when = datetime.datetime.fromisoformat(t)
    except ValueError:
        return "?"
    if when.tzinfo is None:
        when = when.replace(tzinfo=datetime.timezone.utc)
    secs = (datetime.datetime.now(datetime.timezone.utc) - when).total_seconds()
    if secs < 90:
        return "just now"
    if secs < 5400:
        return "%dm ago" % (secs // 60)
    if secs < 172800:
        return "%.0fh ago" % (secs / 3600)
    return "%.0fd ago" % (secs / 86400)


def _age_secs(iso):
    """Seconds since an ISO-ish timestamp ('2026-09-03T01:28:00-0700' or with ':' in
    the offset, or a bare 'YYYY-MM-DD HH:MM'), else None."""
    if not iso:
        return None
    s = str(iso).strip()
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            t = time.strptime(s.replace("Z", "+0000") if fmt.endswith("%z") else s[:19], fmt)
        except ValueError:
            continue
        if fmt.endswith("%z"):
            try:
                import datetime as _dt
                d = _dt.datetime.strptime(s.replace("Z", "+0000"), fmt)
                return time.time() - d.timestamp()
            except Exception:
                return None
        return time.time() - time.mktime(t)
    return None


def _trusted(cwd):
