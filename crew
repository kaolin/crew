# --- commit attribution ------------------------------------------------------
# hooks/crew-hook.py appends one record per `git commit` a session runs:
# {ts, t, session_id, cwd, repo, project, branch, sha, subject}. Read here,
# never written by crew, and no git hook in any repo — the Claude Code
# PostToolUse hook is the only writer, so a commit kaolin makes by hand in a
# terminal is not in it, and a status file is only as current as the newest
# record says it is.
COMMITS_LOG = os.path.join(HOME, ".claude", "status", "_commits.jsonl")


def _commit_records():
    """Every commit record, oldest first. [] when nothing has been recorded."""
    out = []
    try:
        for ln in io.open(COMMITS_LOG, encoding="utf-8", errors="replace"):
            ln = ln.strip()
            if not ln:
                continue
            try:
                r = json.loads(ln)
            except Exception:
                continue
            if isinstance(r, dict) and r.get("sha"):
                out.append(r)
    except OSError:
        pass
    return out


def _slug(s):
    return re.sub(r"[^a-z0-9]", "", str(s or "").lower())


def _commits_for(name, d, recs):
    """Commit records that belong to a status file: the record's repo is the
    status's project (spacetag.json <-> ~/dev/spacetag; erif.json <-> erif_html
    by prefix), or its session id is the one the status names. Slugged so
    BabyPaints/babypaints and erif_html/erif-html meet."""
    sess = str(d.get("session") or "")
    keys = {_slug(name), _slug(re.sub(r"-[0-9a-z]{2}$", "", sess)), _slug(sess)}
    keys.discard("")
    out = []
    for r in recs:
        if sess and r.get("session_id") == sess:
            out.append(r)
            continue
        cands = {_slug(r.get("project")), _slug(os.path.basename((r.get("cwd") or "").rstrip("/")))}
        cands.discard("")
        if cands & keys or any(c.startswith(k) for c in cands for k in keys if len(k) >= 4):
            out.append(r)
    return out


def _commits_since(name, d, recs):
    """(latest record, how many are newer than the status file). A commit after
    `updated_at` is work the file does not describe — the exact measure of
    "how far behind is this status", where the 24 h rule is only a guess."""
    mine = _commits_for(name, d, recs)
    if not mine:
        return None, 0
    latest = max(mine, key=lambda r: r.get("t") or 0)
    age = _age_secs(d.get("updated_at") or d.get("updated"))
    if age is None:
        return latest, 0
    cutoff = time.time() - age
    return latest, sum(1 for r in mine if (r.get("t") or 0) > cutoff)


