AE_LATENCY_LOG = os.path.join(SNAP_DIR, "ae-latency.tsv")


def _ae_latency(timeout=45):
    """Seconds for ONE trivial Apple Event to iTerm2 (`get version`), or None on
    timeout. This is the number Tahoe's regression inflates under a locked screen."""
    t0 = time.time()
    try:
        r = subprocess.run(["osascript", "-e", 'tell application "iTerm2" to get version'],
                           capture_output=True, text=True, timeout=timeout)
        return round(time.time() - t0, 2) if r.returncode == 0 else None
    except subprocess.TimeoutExpired:
        return None


def _macos_build():
    try:
        return subprocess.run(["sw_vers", "-buildVersion"], capture_output=True, text=True).stdout.strip()
    except Exception:
