    try:
        d = json.load(open(os.path.join(HOME, ".claude.json")))
        return bool((d.get("projects") or {}).get(cwd, {}).get("hasTrustDialogAccepted"))
    except Exception:
        return None   # unknown, not untrusted


def _answer_trust_prompts(pending, timeout=45):
    """After restore --go: for each (sid, cwd) launched into an untrusted folder,
    wait for its claude process, look at its screen, and if it is sitting on the
    trust prompt choose 'Yes, I trust this folder' (down, enter). Only that prompt —
    anything else on screen is left alone and reported."""
    done, left = [], list(pending)
    deadline = time.time() + timeout
    while left and time.time() < deadline:
        time.sleep(3)
        ps = subprocess.run(["ps", "-eo", "tty=,command="], capture_output=True, text=True).stdout
        for sid, cwd in list(left):
            tty = next((ln.split(None, 1)[0] for ln in ps.splitlines()
                        if "--resume " + sid in ln and ln.split(None, 1)[0] != "??"), None)
            if not tty:
                continue
            tty = tty if tty.startswith("/dev/") else "/dev/" + tty
            try:
                screen = subprocess.run(["osascript", "-e", _OSA_PEEK, tty],
                                        capture_output=True, text=True, timeout=15).stdout
            except Exception:
                screen = ""
            if "trust this folder" in screen:
                subprocess.run(["osascript", "-e", _OSA_TYPE, tty, "\x1b[B"], capture_output=True, timeout=15)
                time.sleep(0.4)
                subprocess.run(["osascript", "-e", _OSA_SUBMIT, tty], capture_output=True, timeout=15)
                done.append((sid, cwd)); left.remove((sid, cwd))
    return done, left


