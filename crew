def _sample_ae_latency():
    """Append one row: ts, locked, seconds (or 'timeout'), macOS build. Called by the
    snapshot agent, so the log accumulates a picture across lock states and OS
    updates without anyone remembering to measure."""
    secs = _ae_latency()
    os.makedirs(SNAP_DIR, exist_ok=True)
    with open(AE_LATENCY_LOG, "a") as f:
        f.write("%s\t%d\t%s\t%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"), 1 if _screen_locked() else 0,
                                     secs if secs is not None else "timeout", _macos_build()))
    return secs


def cmd_regression(a):
    """A finger on Tahoe's AppleScript regression: is it still there, and is a
    macOS update available that might fix it? Reads the sampled log; with
    --sample takes one measurement now; with --check-update asks softwareupdate
    (network, ~30 s)."""
    if a.sample:
        s = _sample_ae_latency()
        print(f"  one Apple Event to iTerm2 just now: {s if s is not None else 'timeout'} s "
              f"({'locked' if _screen_locked() else 'unlocked'})")
    rows = []
    try:
        for ln in open(AE_LATENCY_LOG):
            parts = ln.rstrip("\n").split("\t")
            if len(parts) == 4:
                rows.append(parts)
    except OSError:
        pass
    print(f"\n  macOS build {_macos_build()} · {len(rows)} sample(s) in {AE_LATENCY_LOG}")
    for lock_flag, label in (("0", "unlocked"), ("1", "locked")):
        vals = [r for r in rows if r[1] == lock_flag]
        if not vals:
            print(f"  {label:<9} no samples yet")
            continue
        nums = sorted(float(r[2]) for r in vals if r[2] != "timeout")
        tmo = sum(1 for r in vals if r[2] == "timeout")
        med = nums[len(nums) // 2] if nums else None
        worst = nums[-1] if nums else None
        by_build = {}
        for r in vals:
            by_build.setdefault(r[3], []).append(r[2])
        print(f"  {label:<9} n={len(vals)}  median={med if med is not None else '—'} s  worst={worst if worst is not None else '—'} s  timeouts={tmo}"
              + ("   builds: " + ", ".join(sorted(by_build)) if len(by_build) > 1 else ""))
    print(c("2", "\n  fixed looks like: locked median falling from seconds to ~0.1 s on a new build."))
    if a.check_update:
        print(c("2", "\n  asking softwareupdate (network)…"))
        try:
            out = subprocess.run(["softwareupdate", "--list"], capture_output=True, text=True, timeout=120)
            body = (out.stdout + out.stderr).strip()
            hits = [ln.strip() for ln in body.splitlines() if "macOS" in ln]
            print("  " + ("\n  ".join(hits) if hits else "no macOS update listed"))
        except Exception as e:
            print(f"  softwareupdate failed: {e}")
    print()


