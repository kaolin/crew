#!/bin/sh
# Launch a Claude Code session as the Telegram control hub for the fleet.
# Bridges your phone (via your own Telegram bot) to crew-driven fleet ops.
# Pairing/allowlist persists in ~/.claude/channels/telegram/ across restarts.
#
# Setup: see docs/reach-your-fleet-from-your-phone.md. Copy
# hub-protocol.example.md to ~/.claude/hub-protocol.md and edit it — that file
# is what tells the hub how to behave.
PROTOCOL="${HUB_PROTOCOL:-$HOME/.claude/hub-protocol.md}"
if [ ! -f "$PROTOCOL" ]; then
  echo "hub: no protocol at $PROTOCOL" >&2
  echo "     cp $(dirname "$0")/hub-protocol.example.md \"$PROTOCOL\" and edit it," >&2
  echo "     or point HUB_PROTOCOL at your own." >&2
  exit 1
fi
exec claude \
  --name hub \
  --channels plugin:telegram@claude-plugins-official \
  --append-system-prompt "$(cat "$PROTOCOL")" \
  "$@"
